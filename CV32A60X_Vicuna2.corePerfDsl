TraceValueMapping {

    [ALL] : {
        pc = "$pc"
    },
    Arith_0 : {
        rd = "$bitfield{rd}"
    },
    Arith_Rs1 : {
        rs1 = "$bitfield{rs1}",
        rd = "$bitfield{rd}"
    },
    Arith_Rs1_Rs2 : {
        rs1 = "$bitfield{rs1}",
        rs2 = "$bitfield{rs2}",
        rd = "$bitfield{rd}"
    },
    Branch : {
        rs1 = "$bitfield{rs1}",
        rs2 = "$bitfield{rs2}",
        brTarget = "$pc + (((int16_t)($bitfield{imm} << 3)) >> 3)",
        //imm = "$bitfield{imm}"
	imm = "($bitfield{imm} | (($bitfield{imm} & 0x1000) ? 0xFFFFFFFFFFFFE000 : 0))" // TODO: Use different sign extend?
    },
    Jump : {
        rd = "$bitfield{rd}",
        brTarget = "$pc + (((int32_t)($bitfield{imm} << 11)) >> 11)",
        //imm = "$bitfield{imm}"
	imm = "($bitfield{imm} | (($bitfield{imm} & 0x1000) ? 0xFFFFFFFFFFFFE000 : 0))" // TODO: Use different sign extend?
    },
    JumpR : {
        rs1 = "$bitfield{rs1}",
        rd = "$bitfield{rd}",
        brTarget = "($reg{$bitfield{rs1}} + (((int16_t)($bitfield{imm} << 4)) >> 4)) & -2U",
        //imm = "$bitfield{imm}"
	imm = "($bitfield{imm} | ((($bitfield{imm} != 0) & 0x1000) ? 0xFFFFFFFFFFFFE000 : 0))" // TODO: Use different sign extend?
    },
    Mul : {
        rs1 = "$bitfield{rs1}",
        rs2 = "$bitfield{rs2}",
        rd  = "$bitfield{rd}"
    },
    Div : {
        rs1 = "$bitfield{rs1}",
        rs2 = "$bitfield{rs2}",
        rd  = "$bitfield{rd}",
        rs1_data = "$reg{$bitfield{rs1}}",
        rs2_data = "$reg{$bitfield{rs2}}"
    },
    DivU : {
        rs1 = "$bitfield{rs1}",
        rs2 = "$bitfield{rs2}",
        rd  = "$bitfield{rd}",
        rs1_data = "$reg{$bitfield{rs1}}",
        rs2_data = "$reg{$bitfield{rs2}}"
    },
    Load : {
        rs1 = "$bitfield{rs1}",
        rd  = "$bitfield{rd}",
        addr = "($reg{$bitfield{rs1}} + $bitfield{imm})"
    },
    Store: {
        rs1 = "$bitfield{rs1}",
        rs2 = "$bitfield{rs2}"
    }
,

    /* === VICUNA2 MAPPING FIX: vector trace fields follow RVV operand classes. */
    V_Load : {
        vd = "$bitfield{vd}",
        rs1 = "$bitfield{rs1}",
        vtype = "$csr{0xC21}",
        vl = "$csr{0xC20}"
    },
    V_Load_Registers : {
        vd = "$bitfield{vd}",
        rs1 = "$bitfield{rs1}",
        nf = "$bitfield{nf}"
    },
    V_Store : {
        vs3 = "$bitfield{vs3}",
        rs1 = "$bitfield{rs1}",
        vtype = "$csr{0xC21}",
        vl = "$csr{0xC20}"
    },
    V_Store_Registers : {
        vs3 = "$bitfield{vs3}",
        rs1 = "$bitfield{rs1}",
        nf = "$bitfield{nf}"
    },
    V_Div_vv : {
        vs1 = "$bitfield{vs1}",
        vs2 = "$bitfield{vs2}",
        vd = "$bitfield{vd}",
        vtype = "$csr{0xC21}"
    },
    V_Div_vx : {
        vs2 = "$bitfield{vs2}",
        rs1 = "$bitfield{rs1}",
        vd = "$bitfield{vd}",
        vtype = "$csr{0xC21}"
    },
    V_Ext : {
