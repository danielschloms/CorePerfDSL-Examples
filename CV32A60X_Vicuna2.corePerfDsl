        vs1 = "$bitfield{vs1}",
        vs2 = "$bitfield{vs2}",
        vd = "$bitfield{vd}",
        vtype = "$csr{0xC21}"
    },
    V_Mask : {
        vs1 = "$bitfield{vs1}",
        vs2 = "$bitfield{vs2}",
        vd = "$bitfield{vd}",
        rd = "$bitfield{rd}",
        vtype = "$csr{0xC21}"
    },
    V_vsetvl : {
        rs1 = "$bitfield{rs1}",
        rs2 = "$bitfield{rs2}",
        rd = "$bitfield{rd}"
    },
    V_vsetvli : {
        rs1 = "$bitfield{rs1}",
        rd = "$bitfield{rd}"
    },
    V_vsetivli : {
        rd = "$bitfield{rd}"}
}

