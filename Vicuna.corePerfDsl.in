/*
CorePerfModel Vicuna (
  core : "RV32IMACFDV"
  use Pipeline : Full_pipeline
  use ConnectorModel : {
    regModel, 
    vectorRegModel, 
    staBranchPredModel, 
    vectorMemModel,
    vectorMemRegistersModel,
    vectorAluModel,
    vectorElmModel,
    vectorDividerModel, 
    vectorSignaller
  }
)
*/
