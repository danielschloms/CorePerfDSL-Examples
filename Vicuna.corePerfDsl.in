  - vse
 */

/*********************************** Microaction Section ***********************************/
Connector {Pc, Pc_np, Pc_p}

// Scalar Registers
Connector {Xa, Xb, Xd}

// Vector Registers
Connector {
  Vs1, 
  Vs2, 
  Vs3, 
  MaskReg, 
  Vd, 
  VdGroupDivider, 
  VdGroupAlu, 
  VdGroupElm, 
  VdGroupLoad, 
  VdGroupLoadRegisters, 
  MaxVdGroup,
  MaxVdGroupNf,
  MaxVdGroupLoadStore
}

// Signaller
Connector {
  XifReturnSignal,
  XifCommitSignal,
  SyncSignal,
  VsetSignal,
  MemArbiterSignal,
  LsuFreeSignal,
  WbRetireSignal
}

Resource {PCGen, Decoder, JumpDecoder}
Resource {IPort_R, DPort_R, DPort_W}
Resource {Decoder_V, Reg_V, ResCtrl, V_Retire}

/* Decode */
Resource {
  Vset,
  ID_Signaller
}

/* Scalar EX */
Resource {
  EX_Nop,
  EX_ALU,
  EX_MUL,
  EX_MULH(5),
  EX_DIV(divider), 
  EX_DIVU(divider_u),
  EX_LSU,
  EX_CSR,
  EX_Signaller
}

/* Scalar WB */
Resource {
  WB_Signaller,
  WB_Nop
}

/* Vector DISP */
Resource {Dispatcher}

/* Vector RES */
Resource {
  V_RES_Nop,
  V_RES_Return_Result,
  V_RES_Signaller
}

/* Vector EX */
Resource {
  V_ALU                 (vectorAluModel),
  V_ALU_Single,
  V_ALU_Single_RegWriter,
  V_ALU_RegWriter,
  V_Divider             (vectorDividerModel),
  V_Divider_RegWriter,
  V_LSU_Mem            (vectorMemModel),
  V_LSU_Mem_Registers  (vectorMemRegistersModel),
  V_LSU_RegWriter,
  V_LSU_MemArbiter_Signaller,
  V_ELM                 (vectorElmModel),
  V_ELM_RegWriter
  // V_EX_LSU_Req_Buffer,
  // V_EX_LSU_Resp_Buffer
}

/****** Microactions ******/

/* uA Instruction Fetch */
Microaction {
  uA_IF_IFetch     (Pc -> IPort_R),
  uA_IF_PCGen      (Pc -> PCGen -> Pc_p)
}

/* uA Decode */
Microaction {
  uA_ID_Decode                (Decoder),
  uA_ID_JumpDecode            (JumpDecoder -> Pc_np),
  uA_ID_JumpDecodeReg         (Xa -> JumpDecoder -> Pc_np),
  uA_ID_Req_SReg_A            (Xa),
  uA_ID_Req_SReg_B            (Xb),
  uA_ID_Req_XifReturnSignal   (XifReturnSignal),
  uA_ID_XifCommitSignal       (ID_Signaller -> XifCommitSignal)
}

/* uA Scalar Execute */
Microaction {
  uA_EX_Vset                  (Vset -> Xd),
  uA_EX_Nop                   (EX_Nop),
  uA_EX_XifReturnSignal       (EX_Signaller -> XifReturnSignal),
  uA_EX_Req_XifReturnSignal   (XifReturnSignal),
  uA_EX_Req_MemArbiter_Signal (MemArbiterSignal),
  uA_EX_Req_SyncSignal        (SyncSignal),
  uA_EX_LSU                   (EX_LSU),
  uA_EX_ALU_RegUpdate         (EX_ALU -> Xd),
  uA_EX_ALU_Branch            (EX_ALU -> Pc_np),
  uA_EX_CSR                   (EX_CSR -> Xd),
  uA_MUL                      (EX_MUL -> Xd),
  uA_MULH                     (EX_MULH -> Xd),
  uA_DIV                      (EX_DIV -> Xd),
  uA_DIVU                     (EX_DIVU -> Xd)
}

/* uA Scalar Writeback */
Microaction {
  uA_WB_Memory_R            (DPort_R -> Xd),
  uA_WB_Memory_W            (DPort_W),
  uA_WB_Nop                 (WB_Nop),
  uA_WB_XifReturnSignal     (WB_Signaller -> XifReturnSignal),
  uA_WB_Req_WbRetireSignal  (WbRetireSignal)
}

/* uA Vector Dispatch & Instruction Queue */
Microaction {
  uA_V_DISP_Dispatch                (Dispatcher),
  uA_V_DISP_Req_Vs1                 (Vs1),
  uA_V_DISP_Req_Vs2                 (Vs2),
  uA_V_DISP_Req_Vs3                 (Vs3),
  // WAW
  uA_V_DISP_Req_MaxVdGroup          (MaxVdGroup),
  uA_V_DISP_Req_MaxVdGroupNf        (MaxVdGroupNf),
  uA_V_DISP_Req_MaxVdGroupLoadStore (MaxVdGroupLoadStore),
  uA_V_DISP_Req_Vd                  (Vd),
  uA_V_DISP_Req_MaskReg             (MaskReg),
  uA_V_DISP_Req_XifCommitSignal     (XifCommitSignal),
  uA_V_DISP_Req_LsuFreeSignal       (LsuFreeSignal)
}

/* uA Vector EX */
Microaction {
  // Arithmetic Pipeline
  uA_V_EX_ALU_Use           (V_ALU),
  uA_V_EX_ALU_Single        (V_ALU_Single),
  uA_V_EX_ALU_Single_Vd     (V_ALU_Single_RegWriter -> Vd),
  uA_V_EX_ALU_SetGroup      (V_ALU_RegWriter -> VdGroupAlu),
  uA_V_EX_Divider_Use       (V_Divider),
  uA_V_EX_Divider_SetGroup  (V_Divider_RegWriter -> VdGroupDivider),

  // LSU/ELM Pipeline
  uA_V_LSU_MemArbiter_Signal        (V_LSU_MemArbiter_Signaller -> MemArbiterSignal),
  uA_V_LSU_Load_SetGroup            (V_LSU_RegWriter -> VdGroupLoad),
  uA_V_LSU_Load_Registers_SetGroup  (V_LSU_RegWriter -> VdGroupLoadRegisters),
  uA_V_LSU_Use                      (V_LSU_Mem -> LsuFreeSignal),
  uA_V_LSU_Mem_Registers            (V_LSU_Mem_Registers),
  uA_V_ELM_Use                      (V_ELM),
  uA_V_ELM_SetGroup                 (V_ELM_RegWriter -> VdGroupElm),
  uA_V_EX_LSU_Require_Free_LSU      (LsuFreeSignal)
  // uA_V_EX_LSU_Req_Buffer            (V_EX_LSU_Req_Buffer),
  // uA_V_EX_LSU_Resp_Buffer           (V_EX_LSU_Resp_Buffer)
}

/* uA Vector RES */
Microaction {
  uA_V_RES_Nop              (V_RES_Nop),
  uA_V_RES_Return_Result    (V_RES_Return_Result -> Xd),
  uA_V_RES_SyncSignal       (V_RES_Signaller -> SyncSignal),
  uA_V_RES_XifReturnSignal  (V_RES_Signaller -> XifReturnSignal)
}

/************************************ Stages & Pipeline ************************************/

// Scalar Pipeline
Stage {
  EX_stage (
    uA_EX_ALU_RegUpdate, 
    uA_EX_ALU_Branch, 
    uA_EX_CSR,
    uA_EX_Req_MemArbiter_Signal,
    uA_EX_Req_SyncSignal,
    uA_EX_LSU, 
    uA_MUL, 
    uA_MULH, 
    uA_DIV, 
    uA_DIVU, 
    uA_EX_Nop,
    uA_EX_Req_XifReturnSignal,
    uA_EX_Vset
  ),

  WB_stage (
    uA_WB_Memory_R,
    uA_WB_Memory_W,
    uA_WB_Nop,
    uA_WB_XifReturnSignal,
    uA_WB_Req_WbRetireSignal
  )        
}
Pipeline Scalar_pipeline (EX_stage -> WB_stage)

/* Vector EX substages */

Stage {
  V_EX_ALU_Unit_substage (
    uA_V_EX_ALU_Use,
    uA_V_EX_ALU_SetGroup,
    uA_V_EX_Divider_Use,
    uA_V_EX_Divider_SetGroup,
    uA_V_EX_ALU_Single,
    uA_V_EX_ALU_Single_Vd
  ),

  // V_EX_LSU_Req_Buffer_substage (uA_V_EX_LSU_Req_Buffer),
  // V_EX_LSU_Resp_Buffer_substage (uA_V_EX_LSU_Resp_Buffer),

  V_EX_LSU_Mem_substage (
    uA_V_LSU_Use,
    uA_V_LSU_Mem_Registers,
    uA_V_LSU_Load_SetGroup,
    uA_V_LSU_Load_Registers_SetGroup,
    uA_V_LSU_MemArbiter_Signal
  ),

  V_EX_ELM_substage (
    uA_V_ELM_Use, 
    uA_V_ELM_SetGroup
  )
}

/* Subpipeline of V_EX_stage */

Resource {
  V_EX_ALU_Unpacker     (3),
  V_EX_LSU_ELM_Unpacker (1),
  V_EX_ALU_Packer,
  V_EX_LSU_ELM_Packer,
  V_EX_ALU_Pipe_Signaller,
  V_EX_LSU_ELM_Pipe_Signaller
}

Microaction {
  uA_V_EX_ALU_Unpack                     (V_EX_ALU_Unpacker),
  uA_V_EX_LSU_ELM_Unpack                 (V_EX_LSU_ELM_Unpacker),
  uA_V_EX_ALU_Pack                       (V_EX_ALU_Packer),
  uA_V_EX_ALU_Pack_Vd                    (V_EX_ALU_Packer -> Vd),
  uA_V_EX_LSU_ELM_Pack                   (V_EX_LSU_ELM_Packer),
  uA_V_EX_LSU_ELM_Pack_WbRetireSignal    (V_EX_LSU_ELM_Packer -> WbRetireSignal)

}

Stage {
  V_EX_ALU_Unpack_substage      (uA_V_EX_ALU_Unpack),
  V_EX_LSU_ELM_Unpack_substage  (uA_V_EX_LSU_ELM_Unpack),
  V_EX_ALU_Pack_substage        (uA_V_EX_ALU_Pack, uA_V_EX_ALU_Pack_Vd),
  V_EX_LSU_ELM_Pack_substage    (uA_V_EX_LSU_ELM_Pack, uA_V_EX_LSU_ELM_Pack_WbRetireSignal)
}

Pipeline {
  V_EX_LSU_subpipeline (
    // V_EX_LSU_Req_Buffer_substage ->
    V_EX_LSU_Mem_substage
    // V_EX_LSU_Resp_Buffer_substage
  ),
  V_EX_ELM_subpipeline (V_EX_ELM_substage)
}

Stage {
  V_EX_LSU_ELM_Unit_substage [capacity: 2] (V_EX_LSU_subpipeline, V_EX_ELM_subpipeline)
}

Pipeline {
  V_EX_ALU_subpipeline (V_EX_ALU_Unpack_substage -> V_EX_ALU_Unit_substage -> V_EX_ALU_Pack_substage),
  V_EX_LSU_ELM_subpipeline (V_EX_LSU_ELM_Unpack_substage -> V_EX_LSU_ELM_Unit_substage)
}

Stage {
  V_EX_stage [capacity: 5] (V_EX_ALU_subpipeline, V_EX_LSU_ELM_subpipeline)
}

// Pipeline {
//   V_EX_subpipeline (V_EX_Unpack_substage -> V_EX_Unit_substage -> V_EX_Pack_substage)
// }

/* Vector Pipeline */

Stage {
  V_DISP_stage (
    uA_V_DISP_Dispatch, 
    uA_V_DISP_Req_Vs1,
    uA_V_DISP_Req_Vs2,
    uA_V_DISP_Req_Vs3,
    uA_V_DISP_Req_Vd,
    uA_V_DISP_Req_MaxVdGroup,
    uA_V_DISP_Req_MaxVdGroupNf,
    uA_V_DISP_Req_MaxVdGroupLoadStore,
    uA_V_DISP_Req_MaskReg,
    uA_V_DISP_Req_XifCommitSignal,
    uA_V_DISP_Req_LsuFreeSignal
    // uA_V_DISP_Req_ALU_Pipe_Free,
    // uA_V_DISP_Req_LSU_ELM_Pipe_Free
  ),
  V_RES_stage (
    uA_V_RES_Nop,
    uA_V_RES_Return_Result,
    uA_V_RES_SyncSignal,
    uA_V_RES_XifReturnSignal
  )
}

Resource {
  V_ID_Decoder
}

Microaction {
  uA_V_ID_Decode (V_ID_Decoder)
}

Stage {
  V_ID_stage (uA_V_ID_Decode)
}

Resource {
  V_IQ_Queue
}

Microaction {
  uA_V_IQ_Queue (V_IQ_Queue)
}

Stage {
  V_IQ_stage [capacity: 2] (uA_V_IQ_Queue)
}

Pipeline Vector_pipeline (V_IQ_stage -> V_DISP_stage -> V_EX_stage -> V_RES_stage)

// Full Pipeline

// Shared Stages
Stage {
  IF_stage (uA_IF_IFetch, uA_IF_PCGen),
  ID_stage (
    uA_ID_Decode, 
    uA_ID_JumpDecode,
    uA_ID_JumpDecodeReg,
    uA_ID_Req_SReg_A,
    uA_ID_Req_SReg_B,
    uA_ID_XifCommitSignal
  )
}

Pipeline Parallel_pipeline (Scalar_pipeline | Vector_pipeline)

Pipeline Full_pipeline (IF_stage -> ID_stage -> Parallel_pipeline)

/************************************* External Models *************************************/
TraceValue {
  rs1, 
  rs2, 
  rd, 
  pc, 
  brTarget, 
  rs2_data, 
  vtype, 
  vl, 
  vs1, 
  vs2, 
  vs3,
  vd, 
  vm,
  nf,
  lsWidth, 
  isWidening
}

ConnectorModel regModel (
  link : "models/common/StandardRegisterModel.h"
  trace : {rs1, rs2, rd}
  connectorIn : Xd
  connectorOut : {Xa, Xb}
)

ConnectorModel vectorRegModel (
  link : "models/Vicuna/VectorRegisterModel.h"
  trace : {vs1, vs2, vs3, vd, vm, vtype, lsWidth, isWidening, nf}
  connectorIn : {Vd, VdGroupDivider, VdGroupAlu, VdGroupElm, VdGroupLoad, VdGroupLoadRegisters}
  connectorOut : {Vs1, Vs2, Vs3, MaskReg, Vd, MaxVdGroup, MaxVdGroupNf, MaxVdGroupLoadStore}
)

ConnectorModel vectorSignaller (
  link : "models/Vicuna/VectorSignaller.h"
  connectorIn : {XifReturnSignal, XifCommitSignal, SyncSignal, VsetSignal, MemArbiterSignal, LsuFreeSignal, WbRetireSignal}
  connectorOut : {XifReturnSignal, XifCommitSignal, VsetSignal, MemArbiterSignal, LsuFreeSignal, WbRetireSignal}
)

ConnectorModel staBranchPredModel (
  link : "models/common/StaticBranchPredictModel.h"
  trace : {pc, brTarget}
  connectorIn : {Pc_np, Pc_p}
  connectorOut : Pc
)

ResourceModel divider (
  link: "models/cv32e40p/DividerModel.h"
  trace: rs2_data
)

ResourceModel divider_u (
  link: "models/cv32e40p/DividerUnsignedModel.h"
  trace: rs2_data
)

ResourceModel vectorMemModel (
  link: "models/Vicuna/VectorMemModel.h"
  trace: {vtype, vl, lsWidth}
)

ResourceModel vectorMemRegistersModel (
  link: "models/Vicuna/VectorMemRegistersModel.h"
  trace: {nf}
)

ResourceModel vectorAluModel (
  link: "models/Vicuna/VectorAluModel.h"
  trace: {vtype, isWidening}
)

ResourceModel vectorElmModel (
  link: "models/Vicuna/VectorElmModel.h"
  trace: {vtype}
)

ResourceModel vectorDividerModel (
  link: "models/Vicuna/VectorDividerModel.h"
  trace: vtype
)

/*********************************** Instruction Section ***********************************/
InstrGroup {
  Arith_Ra_Rb (add, sub, xor, or, and, slt, sltu, sll, srl, sra),
  Arith_Ra (addi, xori, ori, andi, slti, sltiu, slli, srli, srai),
  Arith_X (auipc, lui),
  Mul_Ra_Rb (mul),
  MulH_Ra_Rb (mulh, mulhu, mulhsu),
  Div_Ra_Rb (div, rem),
  DivU_Ra_Rb (divu, remu),
  Csr_Ra (csrrw, csrrs, csrrc),
  Csr_X (csrrwi, csrrsi, csrrci),
  Store (sb, sh, sw),
  Load (lw, lh, lhu, lb, lbu),
  Branch_Ra_Rb (beq, bne, blt, bge, bltu, bgeu),
  V_Load (vle32_v, vle16_v, vle8_v),
  V_Load_Registers (vl8r_v, vl16r_v, vl32r_v),
  V_Store (vse32_u, vse16_u, vse8_u),
  V_Store_Registers (vsr_v),
  V_LS_32 (vle32_v, vse32_u),
  V_LS_16 (vle16_v, vse16_u),
  V_LS_8 (vle8_v, vse8_u),
  V_Div_vv (vdiv_vv, vdivu_vv, vremu_vv, vrem_vv),
  V_Div_vx (vdiv_vx, vdivu_vx, vremu_vx, vrem_vx),

  // Zero/Sign Extension
  V_Ext (vzext_vf2, vsext_vf2, vzext_vf4, vsext_vf4, vzext_vf8, vsext_vf8),

  // ALU op, target vd, source imm
  V_ALU_v_i (vmv_v_i),

  // From vs2[0] to X[rd] 
  V_vmv_x_s (vmv_x_s),
  // From X[rs1] to vd[0]
  V_vmv_s_x (vmv_s_x),

  V_Elm_vv (
    vcompress_vm,
    vredsum_vs,
    vredmaxu_vs,
    vredmax_vs,
    vredminu_vs,
    vredmin_vs,
    vredand_vs,
    vredor_vs,
    vredxor_vs
  ),

  V_Arith_vv (
    vadd_vv,
    vsub_vv,
    vadc_vvm,
    vmadc_vv,
    vsbc_vvm,
    vmsbc_vv,
    vand_vv,
    vor_vv,
    vxor_vv,
    vsll_vv,
    vsrl_vv,
    vsra_vv,
    vmseq_vv,
    vmsne_vv,
    vmsltu_vv,
    vmslt_vv,
    vmsleu_vv,
    vmsle_vv,
    vminu_vv,
    vmin_vv,
    vmaxu_vv,
    vmax_vv,
    vmul_vv,
    vmulh_vv,
    vmulhu_vv,
    vmulhsu_vv,
    vmacc_vv,
    vnmsac_vv,
    vmadd_vv,
    vnmsub_vv,
    vmerge_vvm,
    vsaddu_vv,
    vsadd_vv,
    vssubu_vv,
    vssub_vv,
    vaaddu_vv,
    vaadd_vv,
    vasubu_vv,
    vasub_vv,
    vsmul_vv,
    vssrl_vv,
    vssra_vv
    // vrgather_vv,
    // vrgatherei16_vv
  ),

  V_Arith_Widening_vv (
    vwaddu_vv,
    vwsubu_vv,
    vwadd_vv,
    vwsub_vv,
    vwaddu_w_vv,
    vwsubu_w_vv,
    vwadd_w_vv,
    vwsub_w_vv,
    vwmul_vv,
    vwmulu_vv,
    vwmulsu_vv,
    vwmaccu_vv,
    vwmacc_vv,
    vwmaccsu_vv
  ),

  V_Arith_vx (
    vadd_vx,
    vsub_vx,
    vrsub_vx,
    vadc_vxm,
    vmadc_vx,
    vsbc_vxm,
    vmsbc_vx,   
    vand_vx,
    vor_vx,
    vxor_vx,
    vsll_vx,
    vsrl_vx,
    vsra_vx,
    vmseq_vx,
    vmsne_vx,
    vmsltu_vx,
    vmslt_vx,
    vmsleu_vx,
    vmsle_vx,
    vmsgtu_vx,
    vmsgt_vx,
    vminu_vx,
    vmin_vx,
    vmaxu_vx,
    vmax_vx,
    vmul_vx,
    vmulh_vx,
    vmulhu_vx,
    vmulhsu_vx,
    vwmul_vx, 
    vwmulu_vx,
    vwmulsu_vx,
    vmacc_vx,
    vnmsac_vx,
    vmadd_vx,
    vnmsub_vx,
    vwmaccu_vx,
    vwmacc_vx,
    vwmaccsu_vx,
    vwmaccus_vx,
    vmerge_vxm,
    vsaddu_vx,
    vsadd_vx,
    vssubu_vx,
    vssub_vx,
    vaaddu_vx,
    vaadd_vx,
    vasubu_vx,
    vasub_vx,
    vsmul_vx,
    vssrl_vx,
    vssra_vx,
    vslideup_vx,
    vslidedown_vx,
    vslide1up_vx,
    vslide1down_vx
  ),

  V_Arith_Widening_vx (
    vwaddu_vx,
    vwsubu_vx,
    vwadd_vx,
    vwsub_vx,
    vwaddu_w_vx,
    vwsubu_w_vx,
    vwadd_w_vx,
    vwsub_w_vx
  ),

  V_Arith_vi (
    vadd_vi,
    vrsub_vi,
    vadc_vim,
    vmadc_vi,   
    vand_vi,
    vor_vi,
    vxor_vi,
    vsll_vi,
    vsrl_vi,
    vsra_vi,
    vmseq_vi,
    vmsne_vi,
    vmsleu_vi,
    vmsle_vi,
    vmsgtu_vi,
    vmsgt_vi,
    vmerge_vim,
    vsaddu_vi,
    vsadd_vi,
    vssrl_vi,
    vssra_vi,
    vslideup_vi,
    vslidedown_vi
  ),

  V_vsetivli (vsetivli),
  V_vsetvli (vsetvli),
  V_vsetvl (vsetvl),


  /*
  V_Float_Arith_vv (

  ),

  V_Float_Arith_vf (

  ),

  V_Float_Reduction (

  ),
  */

  Default ([?])
}

MicroactionMapping {
  [ALL] :        {uA_IF_IFetch, uA_IF_PCGen},
  Arith_Ra_Rb :  {uA_ID_Decode, uA_ID_Req_SReg_A, uA_ID_Req_SReg_B, uA_EX_ALU_RegUpdate, uA_EX_Req_XifReturnSignal, uA_WB_Nop},
  Arith_Ra :     {uA_ID_Decode, uA_ID_Req_SReg_A, uA_EX_ALU_RegUpdate, uA_EX_Req_XifReturnSignal, uA_WB_Nop},
  Arith_X :      {uA_ID_Decode, uA_EX_ALU_RegUpdate, uA_EX_Req_XifReturnSignal, uA_WB_Nop},
  Mul_Ra_Rb :    {uA_ID_Decode, uA_ID_Req_SReg_A, uA_ID_Req_SReg_B, uA_MUL, uA_EX_Req_XifReturnSignal, uA_WB_Nop},
  MulH_Ra_Rb :   {uA_ID_Decode, uA_ID_Req_SReg_A, uA_ID_Req_SReg_B, uA_MULH, uA_EX_Req_XifReturnSignal, uA_WB_Nop},
  Div_Ra_Rb :    {uA_ID_Decode, uA_ID_Req_SReg_A, uA_ID_Req_SReg_B, uA_DIV, uA_EX_Req_XifReturnSignal, uA_WB_Nop},
  DivU_Ra_Rb :   {uA_ID_Decode, uA_ID_Req_SReg_A, uA_ID_Req_SReg_B, uA_DIVU, uA_EX_Req_XifReturnSignal, uA_WB_Nop},
  Csr_Ra :       {uA_ID_Decode, uA_ID_Req_SReg_A, uA_EX_CSR, uA_EX_Req_XifReturnSignal, uA_WB_Nop},
  Csr_X :        {uA_ID_Decode, uA_EX_CSR, uA_EX_Req_XifReturnSignal, uA_WB_Nop},
  Store :        {uA_ID_Decode, uA_ID_Req_SReg_A, uA_ID_Req_SReg_B, uA_EX_Req_MemArbiter_Signal, uA_EX_LSU, uA_EX_Req_XifReturnSignal, uA_WB_Memory_W},
  Load :         {uA_ID_Decode, uA_ID_Req_SReg_A, uA_EX_Req_MemArbiter_Signal, uA_EX_LSU, uA_EX_Req_XifReturnSignal, uA_WB_Memory_R},
  Branch_Ra_Rb : {uA_ID_Decode, uA_ID_Req_SReg_A, uA_ID_Req_SReg_B, uA_EX_ALU_Branch, uA_EX_Req_XifReturnSignal, uA_WB_Nop},
  jal :          {uA_ID_JumpDecode, uA_EX_ALU_RegUpdate, uA_EX_Req_XifReturnSignal, uA_WB_Nop},
  jalr :         {uA_ID_JumpDecodeReg, uA_EX_ALU_RegUpdate, uA_EX_Req_XifReturnSignal, uA_WB_Nop},

  V_Div_vv : {
    /* Shared */
    uA_ID_Decode,
    /* Scalar */
    uA_EX_Req_XifReturnSignal,
    uA_WB_XifReturnSignal,
    /* Vector */
    uA_V_IQ_Queue,
    uA_V_DISP_Req_Vs1,
    uA_V_DISP_Req_Vs2,
    uA_V_DISP_Req_MaxVdGroup,
    uA_V_DISP_Req_MaskReg,
    uA_V_DISP_Dispatch,
    uA_V_EX_ALU_Unpack,
    uA_V_EX_Divider_SetGroup,
    uA_V_EX_Divider_Use,
    uA_V_EX_ALU_Pack,
    uA_V_RES_Nop
  },

  V_Div_vx : {
    /* Shared */
    uA_ID_Decode,
    uA_ID_Req_SReg_A,
    /* Scalar */
    uA_EX_Req_XifReturnSignal,
    uA_WB_XifReturnSignal,
    /* Vector */
    uA_V_IQ_Queue,
    uA_V_DISP_Req_Vs2,
    uA_V_DISP_Req_MaxVdGroup,
    uA_V_DISP_Req_MaskReg,
    uA_V_DISP_Dispatch,
    uA_V_EX_ALU_Unpack,
    uA_V_EX_Divider_SetGroup,
    uA_V_EX_Divider_Use,
    uA_V_EX_ALU_Pack,
    uA_V_RES_Nop
  },

  // Same as regular ALU, but only dependend on vs2  
  V_Ext : {
    /* Shared */
    uA_ID_Decode,
    /* Scalar */
    uA_EX_Req_XifReturnSignal,
    uA_WB_XifReturnSignal,
    /* Vector */
    uA_V_IQ_Queue,
    uA_V_DISP_Req_Vs2,
    uA_V_DISP_Req_MaxVdGroup,
    uA_V_DISP_Req_MaskReg,
    uA_V_DISP_Dispatch,
    uA_V_EX_ALU_Unpack,
    uA_V_EX_ALU_SetGroup,
    uA_V_EX_ALU_Use,
    uA_V_EX_ALU_Pack,
    uA_V_RES_Nop
  },

  V_ALU_v_i : {
    /* Shared */
    uA_ID_Decode,
    /* Scalar */
    uA_EX_Req_XifReturnSignal,
    uA_WB_XifReturnSignal,
    /* Vector */
    uA_V_IQ_Queue,
    uA_V_DISP_Req_MaxVdGroup,
    uA_V_DISP_Req_MaskReg,
    uA_V_DISP_Dispatch,
    uA_V_EX_ALU_Unpack,
    uA_V_EX_ALU_SetGroup,
    uA_V_EX_ALU_Use,
    uA_V_EX_ALU_Pack,
    uA_V_RES_Nop
  },

  V_vmv_s_x : {
    /* Shared */
    uA_ID_Decode,
    uA_ID_Req_SReg_A,
    /* Scalar */
    uA_EX_Req_XifReturnSignal,
    uA_WB_XifReturnSignal,
    /* Vector */
    uA_V_IQ_Queue,
    uA_V_DISP_Req_Vd,
    uA_V_DISP_Dispatch,
    uA_V_EX_ALU_Unpack,
    uA_V_EX_ALU_Use,
    uA_V_EX_ALU_Pack_Vd,
    uA_V_RES_Nop
  },


  V_vmv_x_s : {
    /* Shared */
    uA_ID_Decode,
    /* Scalar */
    uA_EX_Req_SyncSignal,
    uA_WB_Nop,
    /* Vector */
    uA_V_IQ_Queue,
    uA_V_DISP_Req_Vs2,
    uA_V_DISP_Dispatch,
    uA_V_EX_ALU_Unpack,
    uA_V_ELM_Use,
    // uA_V_EX_LSU_ELM_Pack,
    uA_V_RES_Return_Result,
    uA_V_RES_SyncSignal
  },

  V_Arith_vv : {
    /* Shared */
    uA_ID_Decode,
    /* Scalar */
    uA_EX_Req_XifReturnSignal,
    uA_WB_XifReturnSignal,
    /* Vector */
    uA_V_IQ_Queue,
    uA_V_DISP_Req_Vs1, 
    uA_V_DISP_Req_Vs2,
    uA_V_DISP_Req_MaxVdGroup,
    uA_V_DISP_Dispatch,
    uA_V_EX_ALU_Unpack,
    uA_V_EX_ALU_SetGroup,
    uA_V_EX_ALU_Use,
    uA_V_EX_ALU_Pack,
    uA_V_RES_Nop
  },

  // Same as V_Arith_vv, but reiterated, since it needs to double LMUL
  V_Arith_Widening_vv : {
    /* Shared */
    uA_ID_Decode,
    /* Scalar */
    uA_EX_Req_XifReturnSignal,
    uA_WB_XifReturnSignal,
    /* Vector */
    uA_V_IQ_Queue,
    uA_V_DISP_Req_Vs1, 
    uA_V_DISP_Req_Vs2,
    uA_V_DISP_Req_MaxVdGroup,
    uA_V_DISP_Dispatch,
    uA_V_EX_ALU_Unpack,
    uA_V_EX_ALU_SetGroup,
    uA_V_EX_ALU_Use,
    uA_V_EX_ALU_Pack,
    uA_V_RES_Nop
  },

  V_Arith_vx : {
    /* Shared */
    uA_ID_Decode,
    uA_ID_Req_SReg_A,
    /* Scalar */
    uA_EX_Req_XifReturnSignal,
    uA_WB_XifReturnSignal,
    /* Vector */
    uA_V_IQ_Queue,
    uA_V_DISP_Req_Vs2,
    uA_V_DISP_Req_MaxVdGroup,
    uA_V_DISP_Dispatch,
    uA_V_EX_ALU_Unpack,
    uA_V_EX_ALU_SetGroup,
    uA_V_EX_ALU_Use,
    uA_V_EX_ALU_Pack,
    uA_V_RES_Nop
  },

  V_Arith_Widening_vx : {
    /* Shared */
    uA_ID_Decode,
    uA_ID_Req_SReg_A,
    /* Scalar */
    uA_EX_Req_XifReturnSignal,
    uA_WB_XifReturnSignal,
    /* Vector */
    uA_V_IQ_Queue,
    uA_V_DISP_Req_Vs2,
    uA_V_DISP_Req_MaxVdGroup,
    uA_V_DISP_Dispatch,
    uA_V_EX_ALU_Unpack,
    uA_V_EX_ALU_SetGroup,
    uA_V_EX_ALU_Use,
    uA_V_EX_ALU_Pack,
    uA_V_RES_Nop
  },

  V_Arith_vi : {
    /* Shared */
    uA_ID_Decode,
    /* Scalar */
    uA_EX_Req_XifReturnSignal,
    uA_WB_XifReturnSignal,
    /* Vector */
    uA_V_IQ_Queue,
    uA_V_DISP_Req_Vs2,
    uA_V_DISP_Req_MaxVdGroup,
    uA_V_DISP_Dispatch,
    uA_V_EX_ALU_Unpack,
    uA_V_EX_ALU_SetGroup,
    uA_V_EX_ALU_Use,
    uA_V_EX_ALU_Pack,
    uA_V_RES_Nop
  },

  V_Elm_vv : {
    /* Shared */
    uA_ID_Decode,
    /* Scalar */
    uA_EX_Req_XifReturnSignal,
    uA_WB_XifReturnSignal,
    /* Vector */
    uA_V_IQ_Queue,
    uA_V_DISP_Req_Vs1, 
    uA_V_DISP_Req_Vs2,
    uA_V_DISP_Req_MaxVdGroup,
    uA_V_DISP_Dispatch,
    uA_V_EX_LSU_ELM_Unpack,
    uA_V_ELM_SetGroup,
    uA_V_ELM_Use,
    // uA_V_EX_LSU_ELM_Pack,
    uA_V_RES_Nop
  },
                
  V_Load : {
    /* Shared */
    uA_ID_Decode,
    uA_ID_Req_SReg_A,
    /* Scalar */
    uA_EX_Nop,
    uA_EX_Req_SyncSignal,
    uA_WB_Nop,
    /* Vector */
    uA_V_IQ_Queue,
    uA_V_DISP_Req_MaxVdGroupLoadStore,  // WAW
    uA_V_DISP_Req_XifCommitSignal,      // XIF Commit Signal
    uA_V_DISP_Req_LsuFreeSignal,        // LSU Unit is available
    uA_V_DISP_Dispatch,
    uA_V_EX_LSU_ELM_Unpack,
    // uA_V_EX_LSU_Req_Buffer,
    uA_V_LSU_Load_SetGroup,
    uA_V_LSU_MemArbiter_Signal,
    uA_V_LSU_Use,
    // uA_V_EX_LSU_Resp_Buffer,
    // uA_V_EX_LSU_ELM_Pack,
    uA_V_RES_SyncSignal
  },

  V_Load_Registers : {
    /* Shared */
    uA_ID_Decode,
    uA_ID_Req_SReg_A,
    /* Scalar */
    uA_EX_Nop,
    uA_WB_Req_WbRetireSignal,
    uA_WB_Nop,
    /* Vector */
    uA_V_IQ_Queue,
    uA_V_DISP_Dispatch,
    uA_V_DISP_Req_MaxVdGroupNf,
    uA_V_EX_LSU_ELM_Unpack,
    // uA_V_EX_LSU_Req_Buffer,
    uA_V_LSU_Load_Registers_SetGroup,
    uA_V_LSU_MemArbiter_Signal,
    uA_V_LSU_Mem_Registers,
    // uA_V_EX_LSU_Resp_Buffer,
    // uA_V_EX_LSU_ELM_Pack_WbRetireSignal,
    uA_V_RES_XifReturnSignal
  },

  V_Store : {
    uA_ID_Decode, 
    uA_ID_Req_SReg_A,
    /* Scalar */
    uA_EX_Nop,
    uA_WB_Req_WbRetireSignal,
    uA_WB_Nop,
    /* Vector */
    uA_V_IQ_Queue,
    uA_V_DISP_Req_Vs3,
    uA_V_DISP_Dispatch,
    uA_V_EX_LSU_ELM_Unpack,
    // uA_V_EX_LSU_Req_Buffer,
    uA_V_LSU_MemArbiter_Signal,
    uA_V_LSU_Use,
    // uA_V_EX_LSU_Resp_Buffer,
    // uA_V_EX_LSU_ELM_Pack_WbRetireSignal,
    uA_V_RES_XifReturnSignal
  },

  V_Store_Registers : {
    /* Shared */
    uA_ID_Decode, 
    uA_ID_Req_SReg_A,
    /* Scalar */
    uA_EX_Nop,
    uA_WB_Req_WbRetireSignal,
    uA_WB_Nop,
    /* Vector */
    uA_V_IQ_Queue,
    uA_V_DISP_Req_Vs3,
    uA_V_DISP_Dispatch,
    uA_V_EX_LSU_ELM_Unpack,
    // uA_V_EX_LSU_Req_Buffer,
    uA_V_LSU_MemArbiter_Signal,
    uA_V_LSU_Mem_Registers,
    // uA_V_EX_LSU_Resp_Buffer,
    // uA_V_EX_LSU_ELM_Pack_WbRetireSignal,
    uA_V_RES_XifReturnSignal
  },

  V_vsetivli : {
    /* Shared */
    uA_ID_Decode,
    uA_ID_Req_XifReturnSignal,
    /* Scalar */
    uA_EX_Vset,
    uA_WB_Nop
  },

  V_vsetvli : {
    /* Shared */
    uA_ID_Decode,
    uA_ID_Req_SReg_A,
    uA_ID_Req_XifReturnSignal,
    /* Scalar */
    uA_EX_Vset,
    uA_WB_Nop
  },

  V_vsetvl: {
    /* Shared */
    uA_ID_Decode,
    uA_ID_Req_SReg_A,
    uA_ID_Req_SReg_B,
    uA_ID_Req_XifReturnSignal,
    /* Scalar */
    uA_EX_Vset,
    uA_WB_Nop
  }
}


TraceValueMapping {
  [ALL] : {
      pc = "$pc"
  },

  Arith_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}"
  },

  Arith_Ra : {
    rs1 = "$bitfield{rs1}",
    rd  = "$bitfield{rd}"
  },

  Arith_X : {
    rd  = "$bitfield{rd}"
  },

  Mul_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}"
  },

  MulH_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}"
  },

  Div_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}",
    rs2_data = "$reg{$bitfield{rs2}}"
  },

  DivU_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}",
    rs2_data = "$reg{$bitfield{rs2}}"
  },

  Csr_Ra : {
    rs1 = "$bitfield{rs1}",
    rd  = "$bitfield{rd}"
  },
  
  Csr_X : {
    rd  = "$bitfield{rd}"
  },

  Store : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}"
  },

  Load : {
    rs1 = "$bitfield{rs1}",
    rd  = "$bitfield{rd}"
  },

  Branch_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    brTarget = "$pc + (((int16_t)($bitfield{imm} << 3)) >> 3)"
  },

  jal : {
    rd = "$bitfield{rd}",
    brTarget = "$pc + (((int32_t)($bitfield{imm} << 11)) >> 11)"
  },

  jalr : {
    rs1 = "$bitfield{rs1}",
    rd  = "$bitfield{rd}",
    brTarget = "($reg{$bitfield{rs1}} + (((int16_t)($bitfield{imm} << 4)) >> 4)) & -2U"
  },

  V_LS_32 : {
    lsWidth = "32"
  },

  V_LS_16 : {
    lsWidth = "16"
  },

  V_LS_8 : {
    lsWidth = "8"
  },

  V_Load : {
    vd = "$bitfield{vd}",
    rs1 = "$bitfield{rs1}",
    // VTYPE CSR Address = 0xC21
    // VL CSR Address = 0xC20;
    vtype = "$csr{0xC21}",
    vl = "$csr{0xC20}"
  },

  V_Load_Registers : {
    vd = "$bitfield{vd}",
    rs1 = "$bitfield{rs1}",
    nf = "$bitfield{nf}"
  },

  V_Store : {
    vs3 = "$bitfield{vs3}",
    rs1 = "$bitfield{rs1}",
    // VTYPE CSR Address = 0xC21
    // VL CSR Address = 0xC20;
    vtype = "$csr{0xC21}",
    vl = "$csr{0xC20}"
  },

  V_Store_Registers : {
    vs3 = "$bitfield{vs3}",
    rs1 = "$bitfield{rs1}",
    nf = "$bitfield{nf}"
  },

  V_Div_vv : {
    vs1 = "$bitfield{vs1}",
    vs2 = "$bitfield{vs2}",
    vd  = "$bitfield{vd}",
    // VTYPE CSR Address = 0xC21
    vtype = "$csr{0xC21}"
  },

  V_Div_vx : {
    vs2 = "$bitfield{vs2}",
    rs1 = "$bitfield{rs1}",
    vd  = "$bitfield{vd}",
    // VTYPE CSR Address = 0xC21
    vtype = "$csr{0xC21}"
  },

  V_Ext : {
    vs2 = "$bitfield{vs2}",
    vd  = "$bitfield{vd}",
    // VTYPE CSR Address = 0xC21
    vtype = "$csr{0xC21}",
    isWidening = "0"
  },

  V_ALU_v_i : {
    vd = "$bitfield{vd}",
    // VTYPE CSR Address = 0xC21
    vtype = "$csr{0xC21}",
    isWidening = "0"
  },

  // TODO: Vector to Scalar: goes into WB and then stalls for a loooong time
  // Previous instrs signal immediately

  V_vmv_s_x : {
    rs1 = "$bitfield{rs1}",
    vd = "$bitfield{vd}",
    isWidening = "0",
    vtype = "$csr{0xC21}"
  },

  V_vmv_x_s : {
    rd = "$bitfield{rd}",
    vs2 = "$bitfield{vs2}",
    vtype = "$csr{0xC21}"
  },

  V_Arith_vv : {
    vs1 = "$bitfield{vs1}",
    vs2 = "$bitfield{vs2}",
    vd  = "$bitfield{vd}",
    // VTYPE CSR Address = 0xC21
    vtype = "$csr{0xC21}",
    isWidening = "0"
  },

  V_Arith_Widening_vv : {
    vs1 = "$bitfield{vs1}",
    vs2 = "$bitfield{vs2}",
    vd  = "$bitfield{vd}",
    // VTYPE CSR Address = 0xC21
    vtype = "$csr{0xC21}",
    isWidening = "1"
  },

  V_Arith_vx : {
    vs2 = "$bitfield{vs2}",
    rs1 = "$bitfield{rs1}",
    vd  = "$bitfield{vd}",
    // VTYPE CSR Address = 0xC21
    vtype = "$csr{0xC21}",
    isWidening = "0"
  },

  V_Arith_Widening_vx : {
    vs2 = "$bitfield{vs2}",
    rs1 = "$bitfield{rs1}",
    vd  = "$bitfield{vd}",
    // VTYPE CSR Address = 0xC21
    vtype = "$csr{0xC21}",
    isWidening = "1"
  },

  V_Arith_vi : {
    vs2 = "$bitfield{vs2}",
    vd  = "$bitfield{vd}",
    // VTYPE CSR Address = 0xC21
    vtype = "$csr{0xC21}",
    isWidening = "0"
  },

  V_Elm_vv : {
    vs1 = "$bitfield{vs1}",
    vs2 = "$bitfield{vs2}",
    vd  = "$bitfield{vd}",
    // VTYPE CSR Address = 0xC21
    vtype = "$csr{0xC21}"
  },

  V_vsetvl : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}"
  },

  V_vsetvli : {
    rs1 = "$bitfield{rs1}",
    rd  = "$bitfield{rd}"
  },

  V_vsetivli : {
    rd  = "$bitfield{rd}"
  }
}

