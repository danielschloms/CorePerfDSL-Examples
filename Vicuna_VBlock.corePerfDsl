TraceValueMapping {
  [ALL] : {
      pc = "$pc"
  },

  Arith_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}"
  },

  Arith_Ra : {
    rs1 = "$bitfield{rs1}",
    rd  = "$bitfield{rd}"
  },

  Arith_X : {
    rd  = "$bitfield{rd}"
  },

  Mul_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}"
  },

  MulH_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}"
  },

  Div_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}",
    rs2_data = "$reg{$bitfield{rs2}}"
  },

  DivU_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}",
    rs2_data = "$reg{$bitfield{rs2}}"
  },

  Csr_Ra : {
    rs1 = "$bitfield{rs1}",
    rd  = "$bitfield{rd}"
  },
  
  Csr_X : {
    rd  = "$bitfield{rd}"
  },

  Store : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}"
  },

  Load : {
    rs1 = "$bitfield{rs1}",
    rd  = "$bitfield{rd}"
  },

  Branch_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    brTarget = "$pc + (((int16_t)($bitfield{imm} << 3)) >> 3)"
  },

  jal : {
    rd = "$bitfield{rd}",
    brTarget = "$pc + (((int32_t)($bitfield{imm} << 11)) >> 11)"
  },

  jalr : {
    rs1 = "$bitfield{rs1}",
    rd  = "$bitfield{rd}",
    brTarget = "($reg{$bitfield{rs1}} + (((int16_t)($bitfield{imm} << 4)) >> 4)) & -2U"
  },

  V_LS_32 : {
    lsWidth = "32"
  },

  V_LS_16 : {
    lsWidth = "16"
  },

  V_LS_8 : {
    lsWidth = "8"
  },

  V_Load : {
    vd = "$bitfield{vd}",
    rs1 = "$bitfield{rs1}",
    // VTYPE CSR Address = 0xC21
    // VL CSR Address = 0xC20;
    vtype = "$csr{0xC21}",
    vl = "$csr{0xC20}"
  },

  V_Load_Registers : {
    vd = "$bitfield{vd}",
    rs1 = "$bitfield{rs1}",
    nf = "$bitfield{nf}"
  },

  V_Store : {
    vs3 = "$bitfield{vs3}",
    rs1 = "$bitfield{rs1}",
    // VTYPE CSR Address = 0xC21
    // VL CSR Address = 0xC20;
    vtype = "$csr{0xC21}",
    vl = "$csr{0xC20}"
  },

  V_Store_Registers : {
    vs3 = "$bitfield{vs3}",
    rs1 = "$bitfield{rs1}",
    nf = "$bitfield{nf}"
  },

  V_Div_vv : {
    vs1 = "$bitfield{vs1}",
    vs2 = "$bitfield{vs2}",
    vd  = "$bitfield{vd}",
    // VTYPE CSR Address = 0xC21
    vtype = "$csr{0xC21}"
  },

  V_Div_vx : {
    vs2 = "$bitfield{vs2}",
    rs1 = "$bitfield{rs1}",
    vd  = "$bitfield{vd}",
    // VTYPE CSR Address = 0xC21
    vtype = "$csr{0xC21}"
  },

  V_Ext : {
    vs2 = "$bitfield{vs2}",
    vd  = "$bitfield{vd}",
    // VTYPE CSR Address = 0xC21
    vtype = "$csr{0xC21}"
  },

  V_vmv_regs : {
    vs2 = "$bitfield{vs2}",
    vd  = "$bitfield{vd}",
    // VTYPE CSR Address = 0xC21
    vtype = "$csr{0xC21}"
  },

  V_vmv_v_i : {
    vd = "$bitfield{vd}",
    // VTYPE CSR Address = 0xC21
    vtype = "$csr{0xC21}"
  },

  V_vmv_s_x : {
    rs1 = "$bitfield{rs1}",
    vd = "$bitfield{vd}",
    vtype = "$csr{0xC21}"
  },

  V_vmv_x_s : {
    rd = "$bitfield{rd}",
    vs2 = "$bitfield{vs2}",
    vtype = "$csr{0xC21}"
  },

  V_ALU_vv : {
    vs1 = "$bitfield{vs1}",
    vs2 = "$bitfield{vs2}",
    vd  = "$bitfield{vd}",
    // VTYPE CSR Address = 0xC21
    vtype = "$csr{0xC21}"
  },

  V_MUL_vv : {
    vs1 = "$bitfield{vs1}",
    vs2 = "$bitfield{vs2}",
    vd  = "$bitfield{vd}",
    // VTYPE CSR Address = 0xC21
    vtype = "$csr{0xC21}"
  },

  V_ALU_Widening_vv : {
    vs1 = "$bitfield{vs1}",
    vs2 = "$bitfield{vs2}",
    vd  = "$bitfield{vd}",
    // VTYPE CSR Address = 0xC21
    vtype = "$csr{0xC21}"
  },

  V_MUL_Widening_vv : {
    vs1 = "$bitfield{vs1}",
    vs2 = "$bitfield{vs2}",
    vd  = "$bitfield{vd}",
    // VTYPE CSR Address = 0xC21
    vtype = "$csr{0xC21}"
  },

  V_ALU_vx : {
    vs2 = "$bitfield{vs2}",
    rs1 = "$bitfield{rs1}",
    vd  = "$bitfield{vd}",
    // VTYPE CSR Address = 0xC21
    vtype = "$csr{0xC21}"
  },

  V_ALU_Widening_vx : {
    vs2 = "$bitfield{vs2}",
    rs1 = "$bitfield{rs1}",
    vd  = "$bitfield{vd}",
    // VTYPE CSR Address = 0xC21
    vtype = "$csr{0xC21}"
  },

  V_ALU_vi : {
    vs2 = "$bitfield{vs2}",
    vd  = "$bitfield{vd}",
    // VTYPE CSR Address = 0xC21
    vtype = "$csr{0xC21}"
  },

  V_RED_vv : {
    vs1 = "$bitfield{vs1}",
    vs2 = "$bitfield{vs2}",
    vd  = "$bitfield{vd}",
    // VTYPE CSR Address = 0xC21
    vtype = "$csr{0xC21}"
  },

  V_vsetvl : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}"
  },

  V_vsetvli : {
    rs1 = "$bitfield{rs1}",
    rd  = "$bitfield{rd}"
  },

  V_vsetivli : {
    rd  = "$bitfield{rd}"
  }
}

