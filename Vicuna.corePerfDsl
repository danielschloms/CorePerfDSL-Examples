  },

  V_vsetvli : {
    /* Scalar */
    uA_IF_Req_VsetSignal,
    uA_ID_Decode,
    uA_ID_Req_SReg_A,
    uA_EX_Req_WbFreeSignal,
    uA_EX_Vset,
    uA_WB_VsetSignal,
    /* Vector */
