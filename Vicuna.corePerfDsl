    // uA_EX_XifCommit,
    uA_EX_Req_WbFreeSignal,
    uA_EX_Nop,
    uA_WB_XifCommit,
    uA_WB_Nop,
    /* Vector */
    uA_V_ID_Decode,
    uA_V_IQ_Queue,
    uA_V_DISP_Req_AllowedEnterTime_LsuElmUnpack,
    uA_V_DISP_Req_MaxVdGroup,
    uA_V_DISP_Dispatch,
    uA_V_EX_LSU_ELM_Enter_Unpack_Vs1_Vs2,
    uA_V_EX_LSU_ELM_Leave_Unpack,
    uA_V_EX_ELM_SetGroupReduce,
    uA_V_EX_ELM_Use,
    uA_V_EX_LSU_ELM_Pack
    // uA_V_RES_Nop
  },
                
  V_Load : {
    /* Scalar */
    uA_IF_Req_VsetSignal,
    uA_ID_Req_SReg_A,
    uA_ID_Decode,
    uA_EX_XifCommit,
    uA_EX_Req_WbFreeSignalSync,
    uA_EX_Nop,
    uA_WB_XifCommit,
    uA_WB_Nop,
    /* Vector */
    uA_V_ID_Req_SReg_A,
    uA_V_ID_Decode,
    uA_V_IQ_Queue,
    uA_V_DISP_Req_MaxVdGroupLoadStore,
    uA_V_DISP_Req_AllowedEnterTime_LsuElmUnpack,
    uA_V_DISP_Dispatch,
    uA_V_EX_LSU_ELM_Enter_Unpack_Load,
    uA_V_EX_LSU_ELM_Leave_Unpack,
    uA_V_EX_LSU_Buffer_Request,
    uA_V_EX_LSU_REQ_Buffer_Req_ReqStallEnd,
    uA_V_EX_LSU_MemRequest,
    uA_V_EX_LSU_Load_SetGroup,
    uA_V_EX_LSU_Use,
    uA_V_EX_LSU_ELM_Pack_CompleteLoad,
    uA_V_RES_WbFreeSignalSync
  },

  V_Load_Registers : {
    /* Scalar */
    uA_IF_Req_VsetSignal,
    uA_ID_Decode,
    uA_ID_Req_SReg_A,
    uA_EX_XifCommit,
    uA_EX_Req_WbFreeSignalSync,
    uA_EX_Nop,
    uA_WB_Nop,
    /* Vector */
    uA_V_ID_Req_SReg_A,
    uA_V_ID_Decode,
    uA_V_IQ_Queue,
    uA_V_DISP_Req_MaxVdGroupNf,
    uA_V_DISP_Req_AllowedEnterTime_LsuElmUnpack,
    uA_V_DISP_Dispatch,
    uA_V_EX_LSU_ELM_Enter_Unpack_LoadNf,
    uA_V_EX_LSU_ELM_Leave_Unpack,
    uA_V_EX_LSU_Buffer_Request,
    uA_V_EX_LSU_REQ_Buffer_Req_ReqStallEnd,
    uA_V_EX_LSU_MemRequest,
    uA_V_EX_LSU_Load_Nf_SetGroup,
    uA_V_EX_LSU_Use_Nf,
    uA_V_EX_LSU_ELM_Pack_CompleteLoad,
    uA_V_RES_WbFreeSignalSync
  },

  V_Store : {
    /* Scalar */
    uA_IF_Req_VsetSignal,
    uA_ID_Req_SReg_A,
    uA_ID_Decode, 
    uA_EX_XifCommit,
    uA_EX_Req_WbFreeSignalSync,
    uA_EX_Nop,
    uA_WB_XifCommit,
    uA_WB_Nop,
    /* Vector */
    uA_V_ID_Req_SReg_A,
    uA_V_ID_Decode,
    uA_V_IQ_Queue,
    uA_V_DISP_Req_AllowedEnterTime_LsuElmUnpack,
    uA_V_DISP_Dispatch,
    uA_V_EX_LSU_ELM_Enter_Unpack_Store,
    uA_V_EX_LSU_ELM_Leave_Unpack,
    uA_V_EX_LSU_Buffer_Request,
    uA_V_EX_LSU_REQ_Buffer_Req_ReqStallEnd,
    uA_V_EX_LSU_MemRequest,
    uA_V_EX_LSU_Use,
    uA_V_EX_LSU_ELM_Pack,
    uA_V_RES_WbFreeSignalSync
  },

  V_Store_Registers : {
    /* Scalar */
    uA_IF_Req_VsetSignal,
    uA_ID_Decode, 
    uA_ID_Req_SReg_A,
    uA_EX_XifCommit,
    uA_EX_Req_WbFreeSignalSync,
    uA_EX_Nop,
    uA_WB_Nop,
    /* Vector */
    uA_V_ID_Req_SReg_A,
    uA_V_ID_Decode,
    uA_V_IQ_Queue,
    uA_V_DISP_Req_AllowedEnterTime_LsuElmUnpack,
    uA_V_DISP_Req_CompleteLoad,
    uA_V_DISP_Dispatch,
    uA_V_EX_LSU_ELM_Enter_Unpack_StoreNf,
    uA_V_EX_LSU_ELM_Leave_Unpack,
    uA_V_EX_LSU_Buffer_Request,
    uA_V_EX_LSU_REQ_Buffer_Req_ReqStallEnd,
    uA_V_EX_LSU_MemRequest,
    uA_V_EX_LSU_Use_Nf,
    uA_V_EX_LSU_ELM_Pack,
    uA_V_RES_WbFreeSignalSync
  },

  V_vsetivli : {
    /* Scalar */
    uA_IF_Req_VsetSignal,
    uA_ID_Decode,
    uA_EX_Req_WbFreeSignal,
    uA_EX_Vset,
    uA_WB_VsetSignal,
    /* Vector */
