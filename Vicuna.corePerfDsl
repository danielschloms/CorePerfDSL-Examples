/*********************************** Microaction Section ***********************************/
Connector {Pc, Pc_np, Pc_p}
Connector {Xa, Xb, Xd}
Connector {Vs1, Vs2, Vs3, Vd, VdGroupDivider, VdGroupAlu, VdGroupLoad, MaxVdGroup}
Connector {XifSignal, XifSignalNext, VsetSignal, MemArbiterSignal}

Resource {PCGen, Decoder, JumpDecoder, LSU, CSR}
Resource {IPort_R, DPort_R, DPort_W}
Resource {S_Retire}
Resource {EX_Dummy}
Resource {V_Pipe_Blocker}
Resource {Decoder_V, Reg_V, ResCtrl, V_Retire}

/* Decode */
Resource {
  Vset_Signaller (2),
  Vset
}

/* Scalar EX */
Resource {
  ALU,
  MUL,
  MULH(5),
  DIV(divider), 
  DIVU(divider_u)
}

/* Vector DISP */
Resource {Dispatcher}

/* Vector RES */
Resource {V_Result}

/* Vector EX */
Resource {
  Signaller,
  V_ALU_Unpacker        (packUnpack),
  V_ALU                 (vectorAluModel),
  V_ALU_RegWriter,
  V_ALU_Packer          (packUnpack),
  V_Divider             (vectorDividerModel),
  V_Divider_RegWriter,
  V_LSU_Load            (vectorMemModel),
  V_LSU_RegWriter,
  V_LSU_MemArbiter_Signaller,
  V_LSU_Packer          (packUnpack),
  V_LSU_Fifo            (9)
}

/* Vector WB */
Resource {
  V_WB_Pass,
  V_DPort_R, 
  V_DPort_W
}

/* Result Signal Pipe */
Resource {
  Result_Signaller,
  R_SIG_Queue,
  R_RET_Retirer
}

/****** Microactions ******/

/* uA Decode */
Microaction {
  uA_ID_Decode        (Decoder),
  uA_ID_JumpDecode    (JumpDecoder -> Pc_np),
  uA_ID_JumpDecodeReg (Xa -> JumpDecoder -> Pc_np),
  uA_ID_Req_SReg_A    (Xa),
  uA_ID_Req_SReg_B    (Xb)
}

/* uA Scalar Execute */
Microaction {
  uA_EX_Vset                  (Vset -> Xd),
  // Dummy action for timing purposes
  uA_EX_Dummy                 (EX_Dummy),
  uA_EX_Req_Xif_Signal        (XifSignalNext),
  uA_EX_Req_MemArbiter_Signal (MemArbiterSignal),
  uA_EX_LSU                   (LSU),
  uA_ALU_RegUpdate            (ALU -> Xd),
  uA_ALU_Branch               (ALU -> Pc_np),
  uA_CSR                      (CSR -> Xd),
  uA_MUL                      (MUL -> Xd),
  uA_MULH                     (MULH -> Xd),
  uA_DIV                      (DIV -> Xd),
  uA_DIVU                     (DIVU -> Xd)
}

Microaction {
  uA_IF_IFetch     (Pc -> IPort_R),
  uA_IF_PCGen      (Pc -> PCGen -> Pc_p)
}

/* uA Scalar Writeback */
Microaction {
  uA_WB_Memory_R  (DPort_R -> Xd),
  uA_WB_Memory_W  (DPort_W),
  uA_WB_Retire    (S_Retire)
}

/* uA Vector Dispatch */
Microaction {
  uA_V_DISP_Dispatch        (Dispatcher),
  uA_V_DISP_Req_Vset_Signal (VsetSignal),
  uA_V_DISP_Req_Vs1         (Vs1),
  uA_V_DISP_Req_Vs2         (Vs2),
  uA_V_DISP_Req_Vs3         (Vs3),
  // WAW
  uA_V_DISP_Req_MaxVdGroup  (MaxVdGroup),
  uA_V_DISP_Req_Vd          (Vd)
}

/* uA Vector EX */
Microaction {
  // Short Arithmetic
  uA_V_EX_ALU_Use           (V_ALU),
  uA_V_EX_ALU_SetGroup      (V_ALU_RegWriter -> VdGroupAlu),
  uA_V_EX_Divider_Use       (V_Divider),
  uA_V_EX_Divider_SetGroup  (V_Divider_RegWriter -> VdGroupDivider),
  uA_V_EX_Unpack            (V_ALU_Unpacker),
  uA_V_EX_Pack              (V_ALU_Packer),
  // LSU/Long Arithmetic
  uA_V_LSU_Require_Free_LSU   (XifSignalNext),
  uA_V_LSU_MemArbiter_Signal  (V_LSU_MemArbiter_Signaller -> MemArbiterSignal),
  uA_V_LSU_Load_SetGroup       (V_LSU_RegWriter -> VdGroupLoad),
  uA_V_LSU_Mem                (V_LSU_Load -> XifSignal),
  uA_V_LSU_Shift_Fifo         (V_LSU_Fifo),
  uA_V_EX_Req_Xif_Signal      (XifSignalNext)
}

Microaction {
  uA_V_WB_Retire    (V_Retire),
  uA_V_WB_Memory_R  (V_DPort_R),
  uA_V_WB_Memory_W  (V_DPort_W),
  uA_V_WB_Pass      (V_WB_Pass)
}

/* Vector RES */
Microaction {
  uA_V_RES_Result (V_Result)
}

/* Signal Result */
Microaction {
  uA_R_SIG_Req_Xif_Signal (XifSignalNext),
  uA_R_SIG_Enqueue        (R_SIG_Queue),
  uA_R_RET_Vset_Signal    (Vset_Signaller -> VsetSignal),
  uA_R_RET_Retire         (R_RET_Retirer)
}

/************************************ Stages & Pipeline ************************************/

// Scalar Pipeline
Stage {
  EX_stage (uA_ALU_RegUpdate, 
            uA_ALU_Branch, 
            uA_CSR,
            uA_EX_Req_MemArbiter_Signal,
            uA_EX_LSU, 
            uA_MUL, 
            uA_MULH, 
            uA_DIV, 
            uA_DIVU, 
            uA_EX_Dummy,
            uA_EX_Req_Xif_Signal,
            uA_EX_Vset),
  WB_stage (uA_WB_Memory_R, uA_WB_Memory_W, uA_V_WB_Retire, uA_WB_Retire)        
}
Pipeline Scalar_pipeline (EX_stage)

// Vector EX substages
Stage {
  // Short Arithmetic Subpipeline
  V_EX_ALU_Unpack_substage (uA_V_EX_Unpack),
  V_EX_ALU_Op_substage (uA_V_EX_ALU_Use,
                        uA_V_EX_ALU_SetGroup,
                        uA_V_EX_Divider_Use,
                        uA_V_EX_Divider_SetGroup),
  V_EX_ALU_Pack_substage (uA_V_EX_Pack),

  // LSU/Long Arithmetic Subpipeline
  V_EX_LSU_substage_fifo (uA_V_LSU_Shift_Fifo),
  V_EX_LSU_substage_last (uA_V_LSU_Require_Free_LSU),
  V_EX_LSU_substage_mem  (uA_V_LSU_Mem,
                          uA_V_LSU_Load_SetGroup,
                          uA_V_EX_Req_Xif_Signal,
                          uA_V_LSU_MemArbiter_Signal)
}

// Subpipeline of VEX_stage
Pipeline {
  V_EX_ALU_subpipeline (V_EX_ALU_Unpack_substage ->
                        V_EX_ALU_Op_substage ->
                        V_EX_ALU_Pack_substage),

  V_EX_LSU_subpipeline (V_EX_LSU_substage_fifo ->
                        V_EX_LSU_substage_last ->
                        V_EX_LSU_substage_mem)
}

/* Vector Pipeline */
Stage {
  V_DISP_stage [capacity: 2] (uA_V_DISP_Dispatch, 
                              uA_V_DISP_Req_Vs1,
                              uA_V_DISP_Req_Vs2,
                              uA_V_DISP_Req_Vs3,
                              uA_V_DISP_Req_Vd,
                              uA_V_DISP_Req_MaxVdGroup,
                              uA_V_DISP_Req_Vset_Signal),
  V_EX_stage [capacity: 2] (V_EX_ALU_subpipeline, V_EX_LSU_subpipeline),
  V_WB_stage (uA_V_WB_Memory_R, uA_V_WB_Memory_W, uA_V_WB_Pass, uA_V_WB_Retire),
  V_RES_stage (uA_V_RES_Result)
}
Pipeline Vector_pipeline (V_DISP_stage -> V_EX_stage -> V_WB_stage -> V_RES_stage)

/* Result Signal Queue */
Stage {
  R_SIG_stage [capacity: 100] (uA_R_SIG_Req_Xif_Signal, uA_R_SIG_Enqueue),
  R_RET_stage (uA_R_RET_Retire, uA_R_RET_Vset_Signal)
}
Pipeline Result_pipeline (R_SIG_stage -> R_RET_stage)

// Full Pipeline

// Shared Stages
Stage {
  IF_stage (uA_IF_IFetch, uA_IF_PCGen),
  ID_stage (uA_ID_Decode, 
            uA_ID_JumpDecode,
            uA_ID_JumpDecodeReg,
            uA_ID_Req_SReg_A,
            uA_ID_Req_SReg_B)
}

// Parallel Pipeline
Pipeline Parallel_pipeline (Scalar_pipeline | Vector_pipeline | Result_pipeline)

Pipeline Vicuna_pipeline (IF_stage -> ID_stage -> Parallel_pipeline)

/************************************* External Models *************************************/
TraceValue {rs1, rs2, rd, pc, brTarget, rs2_data, vtype, vl, vs1, vs2, vs3, vd, lsWidth, isWidening}

ConnectorModel regModel (
  link : "models/common/StandardRegisterModel.h"
  trace : {rs1, rs2, rd}
  connectorIn : Xd
  connectorOut : {Xa, Xb}
)

ConnectorModel vectorRegModel (
  link : "models/Vicuna/VectorRegisterModel.h"
  trace : {vs1, vs2, vs3, vd, vtype, lsWidth, isWidening}
  connectorIn : {Vd, VdGroupDivider, VdGroupAlu, VdGroupLoad}
  connectorOut : {Vs1, Vs2, Vs3, Vd, MaxVdGroup}
)

ConnectorModel vectorSignaller (
  link : "models/Vicuna/VectorSignaller.h"
  connectorIn : {XifSignal, XifSignalNext, VsetSignal, MemArbiterSignal}
  // XifSignalNext adds 1 cycle of delay, 
  // since most instructions actually need the cycle after the result signal
  connectorOut : {XifSignal, XifSignalNext, VsetSignal, MemArbiterSignal}
)

ConnectorModel staBranchPredModel (
  link : "models/common/StaticBranchPredictModel.h"
  trace : {pc, brTarget}
  connectorIn : {Pc_np, Pc_p}
  connectorOut : Pc
)

ResourceModel divider (
  link: "models/cv32e40p/DividerModel.h"
  trace: rs2_data
)

ResourceModel divider_u (
  link: "models/cv32e40p/DividerUnsignedModel.h"
  trace: rs2_data
)

ResourceModel vectorMemModel (
  link: "models/Vicuna/VectorMemModel.h"
  trace: {vtype, vl, lsWidth}
)

ResourceModel vectorAluModel (
  link: "models/Vicuna/VectorAluModel.h"
  trace: {vtype, isWidening}
)

ResourceModel vectorDividerModel (
  link: "models/Vicuna/VectorDividerModel.h"
  trace: vtype
)

ResourceModel packUnpack (
  link: "models/Vicuna/PackUnpack.h"
  trace: vtype
)

/*********************************** Instruction Section ***********************************/
InstrGroup {
  Arith_Ra_Rb (add, sub, xor, or, and, slt, sltu, sll, srl, sra),
  Arith_Ra (addi, xori, ori, andi, slti, sltiu, slli, srli, srai),
  Arith_X (auipc, lui),
  Mul_Ra_Rb (mul),
  MulH_Ra_Rb (mulh, mulhu, mulhsu),
  Div_Ra_Rb (div, rem),
  DivU_Ra_Rb (divu, remu),
  Csr_Ra (csrrw, csrrs, csrrc),
  Csr_X (csrrwi, csrrsi, csrrci),
  Store (sb, sh, sw),
  Load (lw, lh, lhu, lb, lbu),
  Branch_Ra_Rb (beq, bne, blt, bge, bltu, bgeu),
  V_Load (vle32_v, vle16_v, vle8_v),
  V_Store (vse32_u, vse16_u, vse8_u),
  V_LS_32 (vle32_v, vse32_u),
  V_LS_16 (vle16_v, vse16_u),
  V_LS_8 (vle8_v, vse8_u),
  V_Div_vv (vdiv_vv, vdivu_vv, vremu_vv, vrem_vv),
  V_Div_vx (vdiv_vx, vdivu_vx, vremu_vx, vrem_vx),

  // ALU op, target vd, source imm
  V_ALU_v_i (vmv_v_i),

  V_ALU_vv (
    vadd_vv,
    vsub_vv,
    vadc_vvm,
    vmadc_vv,
    vsbc_vvm,
    vmsbc_vv,
