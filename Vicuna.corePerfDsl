    vmsltu_vv,
    vmslt_vv,
    vmsleu_vv,
    vmsle_vv,
    vminu_vv,
    vmin_vv,
    vmaxu_vv,
    vmax_vv,
    vmul_vv,
    vmulh_vv,
    vmulhu_vv,
    vmulhsu_vv,
    vwmul_vv,
    vwmulu_vv,
    vwmulsu_vv,
    vmacc_vv,
    vnmsac_vv,
    vmadd_vv,
    vnmsub_vv,
    vwmaccu_vv,
    vwmacc_vv,
    vwmaccsu_vv,
    vmerge_vvm,
    vsaddu_vv,
    vsadd_vv,
    vssubu_vv,
    vssub_vv,
    vaaddu_vv,
    vaadd_vv,
