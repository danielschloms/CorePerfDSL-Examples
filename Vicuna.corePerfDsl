    vwsub_w_vv
  ),

  V_ALU_vx (
    vadd_vx,
    vsub_vx,
    vrsub_vx,
    vadc_vxm,
    vmadc_vx,
    vsbc_vxm,
    vmsbc_vx,   
    vand_vx,
    vor_vx,
    vxor_vx,
    vsll_vx,
    vsrl_vx,
    vsra_vx,
    vmseq_vx,
    vmsne_vx,
    vmsltu_vx,
    vmslt_vx,
    vmsleu_vx,
    vmsle_vx,
    vmsgtu_vx,
    vmsgt_vx,
    vminu_vx,
    vmin_vx,
    vmaxu_vx,
    vmax_vx,
    vmul_vx,
    vmulh_vx,
    vmulhu_vx,
    vmulhsu_vx,
    vwmul_vx, 
    vwmulu_vx,
    vwmulsu_vx,
    vmacc_vx,
    vnmsac_vx,
    vmadd_vx,
