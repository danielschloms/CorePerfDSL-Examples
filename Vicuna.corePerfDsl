MicroactionMapping {
  [ALL] :        {uA_IF_IFetch, uA_IF_PCGen},
  Arith_Ra_Rb :  {uA_ID_Decode, uA_ID_Req_SReg_A, uA_ID_Req_SReg_B, uA_ALU_RegUpdate, uA_EX_Req_Xif_Signal, uA_WB_Retire},
  Arith_Ra :     {uA_ID_Decode, uA_ID_Req_SReg_A, uA_ALU_RegUpdate, uA_EX_Req_Xif_Signal, uA_WB_Retire},
  Arith_X :      {uA_ID_Decode, uA_ALU_RegUpdate, uA_EX_Req_Xif_Signal, uA_WB_Retire},
  Mul_Ra_Rb :    {uA_ID_Decode, uA_ID_Req_SReg_A, uA_ID_Req_SReg_B, uA_MUL, uA_EX_Req_Xif_Signal, uA_WB_Retire},
  MulH_Ra_Rb :   {uA_ID_Decode, uA_ID_Req_SReg_A, uA_ID_Req_SReg_B, uA_MULH, uA_EX_Req_Xif_Signal, uA_WB_Retire},
  Div_Ra_Rb :    {uA_ID_Decode, uA_ID_Req_SReg_A, uA_ID_Req_SReg_B, uA_DIV, uA_EX_Req_Xif_Signal, uA_WB_Retire},
  DivU_Ra_Rb :   {uA_ID_Decode, uA_ID_Req_SReg_A, uA_ID_Req_SReg_B, uA_DIVU, uA_EX_Req_Xif_Signal, uA_WB_Retire},
  Csr_Ra :       {uA_ID_Decode, uA_ID_Req_SReg_A, uA_CSR, uA_EX_Req_Xif_Signal, uA_WB_Retire},
  Csr_X :        {uA_ID_Decode, uA_CSR, uA_EX_Req_Xif_Signal, uA_WB_Retire},
  Store :        {uA_ID_Decode, uA_ID_Req_SReg_A, uA_ID_Req_SReg_B, uA_EX_Req_MemArbiter_Signal, uA_EX_LSU, uA_WB_Memory_W},
  Load :         {uA_ID_Decode, uA_ID_Req_SReg_A, uA_EX_Req_MemArbiter_Signal, uA_EX_LSU, uA_WB_Memory_R},
  Branch_Ra_Rb : {uA_ID_Decode, uA_ID_Req_SReg_A, uA_ID_Req_SReg_B, uA_ALU_Branch, uA_EX_Req_Xif_Signal, uA_WB_Retire},
  jal :          {uA_ID_JumpDecode, uA_ALU_RegUpdate, uA_EX_Req_Xif_Signal, uA_WB_Retire},
  jalr :         {uA_ID_JumpDecodeReg, uA_ALU_RegUpdate, uA_EX_Req_Xif_Signal, uA_WB_Retire},

  V_Div_vv :     {/* shared */
                  uA_ID_Decode,
                  /* vector */
                  uA_V_DISP_Req_MaxVdGroup,
                  uA_V_DISP_Req_Vs1,
                  uA_V_DISP_Req_Vs2,
                  uA_V_DISP_Req_Vset_Signal,
                  uA_V_DISP_Dispatch,
                  uA_V_EX_Unpack,
                  uA_V_EX_Divider_SetGroup,
                  uA_V_EX_Divider_Use,
                  uA_V_EX_Pack,
                  uA_V_WB_Pass,
                  uA_V_RES_Result,
                  /* result queue */
                  uA_R_SIG_Req_Xif_Signal,
                  uA_R_RET_Retire},

  V_Div_vx :     {/* shared */
                  uA_ID_Decode,
                  uA_ID_Req_SReg_A,
                  /* vector */
                  uA_V_DISP_Req_MaxVdGroup,
                  uA_V_DISP_Req_Vs2,
                  uA_V_DISP_Req_Vset_Signal,
                  uA_V_DISP_Dispatch,
                  uA_V_EX_Unpack,
                  uA_V_EX_Divider_SetGroup,
                  uA_V_EX_Divider_Use,
                  uA_V_EX_Pack,
                  uA_V_WB_Pass,
                  uA_V_RES_Result,
                  /* result queue */
                  uA_R_SIG_Req_Xif_Signal,
                  uA_R_RET_Retire},

  V_ALU_v_i :  {/* shared */
                uA_ID_Decode,
                /* vector */
                uA_V_DISP_Req_MaxVdGroup,
                uA_V_DISP_Dispatch,
                uA_V_DISP_Req_Vset_Signal,
                uA_V_EX_Unpack,
                uA_V_EX_ALU_SetGroup,
                uA_V_EX_ALU_Use,
                uA_V_EX_Pack,
                uA_V_WB_Pass,
                uA_V_RES_Result,
                /* result queue */
                uA_R_SIG_Enqueue,
                uA_R_SIG_Req_Xif_Signal,
                uA_R_RET_Retire},

  V_ALU_vv :   {/* shared */
                uA_ID_Decode,
                /* vector */
                uA_V_DISP_Req_MaxVdGroup,
                uA_V_DISP_Req_Vs1, 
                uA_V_DISP_Req_Vs2,
                uA_V_DISP_Req_Vset_Signal,
                uA_V_DISP_Dispatch,
                uA_V_EX_Unpack,
                uA_V_EX_ALU_SetGroup,
                uA_V_EX_ALU_Use,
                uA_V_EX_Pack,
                uA_V_WB_Pass,
                uA_V_RES_Result,
                /* result queue */
                uA_R_SIG_Enqueue,
                uA_R_SIG_Req_Xif_Signal,
                uA_R_RET_Retire},

  // Same as V_ALU_vv, but reiterated, since it needs to double LMUL
  V_ALU_Widening_vv : {/* shared */
                       uA_ID_Decode,
                       /* vector */
                       uA_V_DISP_Req_MaxVdGroup,
                       uA_V_DISP_Req_Vs1, 
                       uA_V_DISP_Req_Vs2,
                       uA_V_DISP_Req_Vset_Signal,
                       uA_V_DISP_Dispatch,
                       uA_V_EX_Unpack,
                       uA_V_EX_ALU_SetGroup,
                       uA_V_EX_ALU_Use,
                       uA_V_EX_Pack,
                       uA_V_WB_Pass,
                       uA_V_RES_Result,
                       /* result queue */
                       uA_R_SIG_Enqueue,
                       uA_R_SIG_Req_Xif_Signal,
                       uA_R_RET_Retire},

  V_ALU_vx :   {/* shared */
                uA_ID_Decode,
                uA_ID_Req_SReg_A,
                /* vector */
                uA_V_DISP_Req_MaxVdGroup,
                uA_V_DISP_Req_Vs2,
                uA_V_DISP_Req_Vset_Signal,
                uA_V_DISP_Dispatch,
                uA_V_EX_Unpack,
                uA_V_EX_ALU_SetGroup,
                uA_V_EX_ALU_Use  ,
                uA_V_EX_Pack,
                uA_V_WB_Pass,
                uA_V_RES_Result,
                /* result queue */
                uA_R_SIG_Enqueue,
                uA_R_SIG_Req_Xif_Signal,
                uA_R_RET_Retire},

  V_ALU_Widening_vx : {/* shared */
                       uA_ID_Decode,
                       uA_ID_Req_SReg_A,
                       /* vector */
                       uA_V_DISP_Req_MaxVdGroup,
                       uA_V_DISP_Req_Vs2,
                       uA_V_DISP_Req_Vset_Signal,
                       uA_V_DISP_Dispatch,
                       uA_V_EX_Unpack,
                       uA_V_EX_ALU_SetGroup,
                       uA_V_EX_ALU_Use  ,
                       uA_V_EX_Pack,
                       uA_V_WB_Pass,
                       uA_V_RES_Result,
                       /* result queue */
                       uA_R_SIG_Enqueue,
                       uA_R_SIG_Req_Xif_Signal,
                       uA_R_RET_Retire},

  V_ALU_vi :   {/* shared */
                uA_ID_Decode,
                /* vector */
                uA_V_DISP_Req_MaxVdGroup,
                uA_V_DISP_Req_Vs2,
                uA_V_DISP_Req_Vset_Signal,
                uA_V_DISP_Dispatch,
                uA_V_EX_Unpack,
                uA_V_EX_ALU_SetGroup,
                uA_V_EX_ALU_Use,
                uA_V_EX_Pack,
                uA_V_WB_Pass,
                uA_V_RES_Result,
                /* result queue */
                uA_R_SIG_Enqueue,
                uA_R_SIG_Req_Xif_Signal,
                uA_R_RET_Retire},

  V_Load :     {uA_ID_Decode,
                uA_ID_Req_SReg_A,
                uA_V_DISP_Req_MaxVdGroup,
                uA_V_DISP_Dispatch,
                uA_V_DISP_Req_Vset_Signal,
                uA_V_LSU_Shift_Fifo,
                uA_V_LSU_Require_Free_LSU,
                uA_V_LSU_Load_SetGroup,
                uA_V_LSU_MemArbiter_Signal,
                uA_V_LSU_Mem,
                uA_V_WB_Memory_R,
                uA_V_RES_Result
                },

  V_Store :      {uA_ID_Decode, 
                  uA_ID_Req_SReg_A,
                  uA_V_DISP_Req_Vs3,
                  uA_V_DISP_Req_Vset_Signal,
                  uA_V_DISP_Dispatch,
                  uA_V_LSU_Shift_Fifo,
                  uA_V_LSU_Require_Free_LSU,
                  uA_V_LSU_MemArbiter_Signal,
                  uA_V_LSU_Mem,
                  uA_V_WB_Memory_W,
                  uA_V_RES_Result
                  },

  V_vsetivli:    {uA_ID_Decode,
                  uA_EX_Vset,
                  uA_WB_Retire,
                  uA_R_SIG_Enqueue,
                  uA_R_SIG_Req_Xif_Signal,
                  uA_R_RET_Vset_Signal,
                  uA_R_RET_Retire},

  V_vsetvli:     {uA_ID_Decode, 
                  uA_ID_Req_SReg_A,
                  uA_EX_Vset,
                  uA_WB_Retire,
                  uA_R_SIG_Enqueue,
                  uA_R_SIG_Req_Xif_Signal,
                  uA_R_RET_Vset_Signal,
                  uA_R_RET_Retire},

  V_vsetvl:      {uA_ID_Decode,
                  uA_ID_Req_SReg_A,
                  uA_ID_Req_SReg_B,
                  uA_EX_Vset,
                  uA_WB_Retire,
                  uA_R_SIG_Enqueue,
                  uA_R_SIG_Req_Xif_Signal,
                  uA_R_RET_Vset_Signal,
                  uA_R_RET_Retire}
}


TraceValueMapping {
  [ALL] : {
      pc = "$pc"
  },

  Arith_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}"
  },

  Arith_Ra : {
    rs1 = "$bitfield{rs1}",
    rd  = "$bitfield{rd}"
  },

  Arith_X : {
    rd  = "$bitfield{rd}"
  },

  Mul_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}"
  },

  MulH_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}"
  },

  Div_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}",
    rs2_data = "$reg{$bitfield{rs2}}"
  },

  DivU_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}",
    rs2_data = "$reg{$bitfield{rs2}}"
  },

  Csr_Ra : {
    rs1 = "$bitfield{rs1}",
    rd  = "$bitfield{rd}"
  },
  
  Csr_X : {
    rd  = "$bitfield{rd}"
  },

  Store : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}"
  },

  Load : {
    rs1 = "$bitfield{rs1}",
    rd  = "$bitfield{rd}"
  },

  Branch_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    brTarget = "$pc + (((int16_t)($bitfield{imm} << 3)) >> 3)"
  },

  jal : {
    rd = "$bitfield{rd}",
    brTarget = "$pc + (((int32_t)($bitfield{imm} << 11)) >> 11)"
  },

  jalr : {
    rs1 = "$bitfield{rs1}",
    rd  = "$bitfield{rd}",
    brTarget = "($reg{$bitfield{rs1}} + (((int16_t)($bitfield{imm} << 4)) >> 4)) & -2U"
  },

  V_LS_32 : {
    lsWidth = "32"
  },

  V_LS_16 : {
    lsWidth = "16"
  },

  V_LS_8 : {
    lsWidth = "8"
  },

  V_Load : {
    vd = "$bitfield{vd}",
    rs1 = "$bitfield{rs1}",
    // VTYPE CSR Address = 0xC21
    // VL CSR Address = 0xC20;
    vtype = "$csr{0xC21}",
    vl = "$csr{0xC20}"
  },

  V_Store : {
    vs3 = "$bitfield{vs3}",
    rs1 = "$bitfield{rs1}",
    // VTYPE CSR Address = 0xC21
    // VL CSR Address = 0xC20;
    vtype = "$csr{0xC21}",
    vl = "$csr{0xC20}"
  },

  V_Div_vv : {
    vs1 = "$bitfield{vs1}",
    vs2 = "$bitfield{vs2}",
    vd  = "$bitfield{vd}",
    // VTYPE CSR Address = 0xC21
    vtype = "$csr{0xC21}"
  },

  V_Div_vx : {
    vs2 = "$bitfield{vs2}",
    rs1 = "$bitfield{rs1}",
    vd  = "$bitfield{vd}",
    // VTYPE CSR Address = 0xC21
    vtype = "$csr{0xC21}"
  },

  V_ALU_v_i : {
    vd = "$bitfield{vd}",
    // VTYPE CSR Address = 0xC21
    vtype = "$csr{0xC21}",
    isWidening = "0"
  },

  V_ALU_vv : {
    vs1 = "$bitfield{vs1}",
    vs2 = "$bitfield{vs2}",
    vd  = "$bitfield{vd}",
    // VTYPE CSR Address = 0xC21
    vtype = "$csr{0xC21}",
    isWidening = "0"
  },

  V_ALU_Widening_vv : {
    vs1 = "$bitfield{vs1}",
    vs2 = "$bitfield{vs2}",
    vd  = "$bitfield{vd}",
    // VTYPE CSR Address = 0xC21
    vtype = "$csr{0xC21}",
    isWidening = "1"
  },

  V_ALU_vx : {
    vs2 = "$bitfield{vs2}",
    rs1 = "$bitfield{rs1}",
    vd  = "$bitfield{vd}",
    // VTYPE CSR Address = 0xC21
    vtype = "$csr{0xC21}",
    isWidening = "0"
  },

  V_ALU_Widening_vx : {
    vs2 = "$bitfield{vs2}",
    rs1 = "$bitfield{rs1}",
    vd  = "$bitfield{vd}",
    // VTYPE CSR Address = 0xC21
    vtype = "$csr{0xC21}",
    isWidening = "1"
  },

  V_ALU_vi : {
    vs2 = "$bitfield{vs2}",
    vd  = "$bitfield{vd}",
    // VTYPE CSR Address = 0xC21
    vtype = "$csr{0xC21}",
    isWidening = "0"
  },

  V_vsetvl : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}"
  },

  V_vsetvli : {
    rs1 = "$bitfield{rs1}",
    rd  = "$bitfield{rd}"
  },

  V_vsetivli : {
    rd  = "$bitfield{rd}"
  }
}

/**************************************** Variants *****************************************/
CorePerfModel Vicuna (
  core : "RV32IMACFDV"
  use Pipeline : Vicuna_pipeline
  use ConnectorModel : {
    regModel, 
    vectorRegModel, 
    staBranchPredModel, 
    vectorMemModel,
    vectorAluModel,
    vectorDividerModel, 
    vectorSignaller,
    packUnpack
  }
)