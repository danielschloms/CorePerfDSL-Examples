/*********************************** Instruction Section ***********************************/
InstrGroup {
  Arith_Ra_Rb (add, sub, xor, or, and, slt, sltu, sll, srl, sra),
  Arith_Ra (addi, xori, ori, andi, slti, sltiu, slli, srli, srai),
  Arith_X (auipc, lui),
  Mul_Ra_Rb (mul),
  MulH_Ra_Rb (mulh, mulhu, mulhsu),
  Div_Ra_Rb (div, rem),
  DivU_Ra_Rb (divu, remu),
  Csr_Ra (csrrw, csrrs, csrrc),
  Csr_X (csrrwi, csrrsi, csrrci),
  Store (sb, sh, sw),
  Load (lw, lh, lhu, lb, lbu),
  Branch_Ra_Rb (beq, bne, blt, bge, bltu, bgeu),
  V_Load (vle32_v, vle16_v, vle8_v),
  V_Load_Registers (vl8r_v, vl16r_v, vl32r_v),
  V_Store (vse32_u, vse16_u, vse8_u),
  V_Store_Registers (vsr_v),
  V_LS_32 (vle32_v, vse32_u),
  V_LS_16 (vle16_v, vse16_u),
  V_LS_8 (vle8_v, vse8_u),
  V_Div_vv (vdiv_vv, vdivu_vv, vremu_vv, vrem_vv),
  V_Div_vx (vdiv_vx, vdivu_vx, vremu_vx, vrem_vx),

  // Zero/Sign Extension
  V_Ext (vzext_vf2, vsext_vf2, vzext_vf4, vsext_vf4, vzext_vf8, vsext_vf8),

  // ALU op, target vd, source imm
  V_vmv_v_i (vmv_v_i),


  // From vs2[0] to X[rd] 
  V_vmv_x_s (vmv_x_s),
  // From X[rs1] to vd[0]
  V_vmv_s_x (vmv_s_x),

  V_RED_vv (
    vcompress_vm,
    vredsum_vs,
    vredmaxu_vs,
    vredmax_vs,
    vredminu_vs,
    vredmin_vs,
    vredand_vs,
    vredor_vs,
    vredxor_vs
  ),

  V_ALU_vv (
    vadd_vv,
    vsub_vv,
    vadc_vvm,
    vmadc_vv,
    vsbc_vvm,
    vmsbc_vv,
    vand_vv,
    vor_vv,
    vxor_vv,
    vsll_vv,
    vsrl_vv,
    vsra_vv,
    vmseq_vv,
    vmsne_vv,
    vmsltu_vv,
    vmslt_vv,
    vmsleu_vv,
    vmsle_vv,
    vminu_vv,
    vmin_vv,
    vmaxu_vv,
    vmax_vv,
    vmerge_vvm,
    vsaddu_vv,
    vsadd_vv,
    vssubu_vv,
    vssub_vv,
    vaaddu_vv,
    vaadd_vv,
    vasubu_vv,
    vasub_vv,
    vsmul_vv,
    vssrl_vv,
    vssra_vv
    // vrgather_vv,
    // vrgatherei16_vv
  ),

  V_MUL_vv (
    vmul_vv,
    vmulh_vv,
    vmulhu_vv,
    vmulhsu_vv,
    vmacc_vv,
    vnmsac_vv,
    vmadd_vv,
    vnmsub_vv
  ),

  V_ALU_Widening_vv (
    vwaddu_vv,
    vwsubu_vv,
    vwadd_vv,
    vwsub_vv,
    vwaddu_w_vv,
    vwsubu_w_vv,
    vwadd_w_vv,
    vwsub_w_vv
  ),

  V_MUL_Widening_vv (
    vwmul_vv,
    vwmulu_vv,
    vwmulsu_vv,
    vwmaccu_vv,
    vwmacc_vv,
    vwmaccsu_vv
  ),

  V_ALU_vx (
    vadd_vx,
    vsub_vx,
    vrsub_vx,
    vadc_vxm,
    vmadc_vx,
    vsbc_vxm,
    vmsbc_vx,   
    vand_vx,
    vor_vx,
    vxor_vx,
    vsll_vx,
    vsrl_vx,
    vsra_vx,
    vmseq_vx,
    vmsne_vx,
    vmsltu_vx,
    vmslt_vx,
    vmsleu_vx,
    vmsle_vx,
    vmsgtu_vx,
    vmsgt_vx,
    vminu_vx,
    vmin_vx,
    vmaxu_vx,
    vmax_vx,
    vmul_vx,
    vmulh_vx,
    vmulhu_vx,
    vmulhsu_vx,
    vwmul_vx, 
    vwmulu_vx,
    vwmulsu_vx,
    vmacc_vx,
    vnmsac_vx,
    vmadd_vx,
    vnmsub_vx,
    vwmaccu_vx,
    vwmacc_vx,
    vwmaccsu_vx,
    vwmaccus_vx,
    vmerge_vxm,
    vsaddu_vx,
    vsadd_vx,
    vssubu_vx,
    vssub_vx,
    vaaddu_vx,
    vaadd_vx,
    vasubu_vx,
    vasub_vx,
    vsmul_vx,
    vssrl_vx,
    vssra_vx,
    vslideup_vx,
    vslidedown_vx,
    vslide1up_vx,
    vslide1down_vx
  ),

  V_Arith_Widening_vx (
    vwaddu_vx,
    vwsubu_vx,
    vwadd_vx,
    vwsub_vx,
    vwaddu_w_vx,
    vwsubu_w_vx,
    vwadd_w_vx,
    vwsub_w_vx
  ),

  V_Arith_vi (
    vadd_vi,
    vrsub_vi,
    vadc_vim,
    vmadc_vi,   
    vand_vi,
    vor_vi,
    vxor_vi,
    vsll_vi,
    vsrl_vi,
    vsra_vi,
    vmseq_vi,
    vmsne_vi,
    vmsleu_vi,
    vmsle_vi,
    vmsgtu_vi,
    vmsgt_vi,
    vmerge_vim,
    vsaddu_vi,
    vsadd_vi,
    vssrl_vi,
    vssra_vi,
    vslideup_vi,
    vslidedown_vi
  ),

  V_vsetivli (vsetivli),
  V_vsetvli (vsetvli),
  V_vsetvl (vsetvl),

  Default ([?])
}

MicroactionMapping {
  [ALL] :        {uA_IF_IFetch, uA_IF_PCGen},
  Arith_Ra_Rb :  {uA_ID_Decode, uA_ID_Req_SReg_A, uA_ID_Req_SReg_B, uA_EX_ALU_RegUpdate, uA_EX_Req_WbFreeSignal, uA_WB_Nop},
  Arith_Ra :     {uA_ID_Decode, uA_ID_Req_SReg_A, uA_EX_ALU_RegUpdate, uA_EX_Req_WbFreeSignal, uA_WB_Nop},
  Arith_X :      {uA_ID_Decode, uA_EX_ALU_RegUpdate, uA_EX_Req_WbFreeSignal, uA_WB_Nop},
  Mul_Ra_Rb :    {uA_ID_Decode, uA_ID_Req_SReg_A, uA_ID_Req_SReg_B, uA_MUL, uA_EX_Req_WbFreeSignal, uA_WB_Nop},
  MulH_Ra_Rb :   {uA_ID_Decode, uA_ID_Req_SReg_A, uA_ID_Req_SReg_B, uA_MULH, uA_EX_Req_WbFreeSignal, uA_WB_Nop},
  Div_Ra_Rb :    {uA_ID_Decode, uA_ID_Req_SReg_A, uA_ID_Req_SReg_B, uA_DIV, uA_EX_Req_WbFreeSignal, uA_WB_Nop},
  DivU_Ra_Rb :   {uA_ID_Decode, uA_ID_Req_SReg_A, uA_ID_Req_SReg_B, uA_DIVU, uA_EX_Req_WbFreeSignal, uA_WB_Nop},
  Csr_Ra :       {uA_ID_Decode, uA_ID_Req_SReg_A, uA_EX_Nop, uA_EX_Req_WbFreeSignal, uA_WB_CSR},
  Csr_X :        {uA_ID_Decode, uA_EX_Nop, uA_EX_Req_WbFreeSignal, uA_WB_CSR},
  Store :        {uA_ID_Decode, uA_ID_Req_SReg_A, uA_ID_Req_SReg_B, uA_EX_Req_MemArbiter_Signal, uA_EX_LSU, uA_EX_Req_WbFreeSignal, uA_WB_Memory_W},
  Load :         {uA_ID_Decode, uA_ID_Req_SReg_A, uA_EX_Req_MemArbiter_Signal, uA_EX_LSU, uA_EX_Req_WbFreeSignal, uA_WB_Memory_R},
  Branch_Ra_Rb : {uA_ID_Decode, uA_ID_Req_SReg_A, uA_ID_Req_SReg_B, uA_EX_ALU_Branch, uA_EX_Req_WbFreeSignal, uA_WB_Nop},
  jal :          {uA_ID_JumpDecode, uA_EX_ALU_RegUpdate, uA_EX_Req_WbFreeSignal, uA_WB_Nop},
  jalr :         {uA_ID_JumpDecodeReg, uA_EX_ALU_RegUpdate, uA_EX_Req_WbFreeSignal, uA_WB_Nop},

  V_Div_vv : {
    /* Scalar */
    uA_IF_Req_VsetSignal,
    uA_ID_Decode,
    uA_EX_XifCommit,
    uA_EX_Req_WbFreeSignal,
    uA_WB_Nop,
    /* Vector */
    uA_V_ID_Decode,
    uA_V_IQ_Queue,
    uA_V_DISP_Req_MaxVdGroup,
    uA_V_DISP_Req_MaskReg,
    uA_V_DISP_Req_AllowedEnterTime_ArithUnpack,
    uA_V_DISP_Dispatch,
    uA_V_EX_Arith_Enter_Unpack_Vs1_Vs2,
    uA_V_EX_Arith_Leave_Unpack,
    uA_V_EX_DIV_SetGroup,
    uA_V_EX_DIV_Use
    // uA_V_EX_Arith_Pack
  },

  V_Div_vx : {
    /* Scalar */
