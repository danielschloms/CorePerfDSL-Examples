 /* 
  TODO:
  - vse
 */

/*********************************** Microaction Section ***********************************/
Connector {Pc, Pc_np, Pc_p}

// Scalar Registers
Connector {Xa, Xb, Xd}

// Vector Registers
Connector {
  Vs1, 
  Vs2, 
  Vs3, 
  MaskReg, 
  Vd, 
  VdGroupDiv, 
  VdGroupArith,
  VdGroupArithWidening,
  VdGroupElm,
  VdGroupReduce,
  VdGroupLoad, 
  VdGroupLoadNf, 
  MaxVdGroup,
  MaxVdGroupNf,
  MaxVdGroupLoadStore,
  // LSU/ELM Unpack
  AllowedEnterTimeLsuElmUnpack,
  EnterLsuElmUnpack,
  EnterLsuElmUnpackVs2,
  EnterLsuElmUnpackVs1Vs2,
  EnterLsuElmUnpackLoad,
  EnterLsuElmUnpackLoadNf,
  EnterLsuElmUnpackStore,
  EnterLsuElmUnpackStoreNf,
  LeaveLsuElmUnpack,
  FreeLastLsuElmUnpackStage,
  ReqStallEnd,
  CompleteLoad,
  LoadStoreStallEnd,
  // Arith Unpack
  AllowedEnterTimeArithUnpack,
  AllowedEnterTimeArithUnpackVs1Vs2,
  EnterArithUnpack,
  EnterArithUnpackExt,
  EnterArithUnpackVs2,
  EnterArithUnpackVs1Vs2,
  LeaveArithUnpack,
  VregWritePortFree,
  XifCommitSignal
}

// Signaller
Connector {
  WbFreeSignal,
  WbFreeSignalSync,
  SyncSignal,
  MemArbiterSignal,
  VsetSignal
}

// LSU/ELM Shift Register
Connector {
  EnterShiftRegister,
  LeaveShiftRegister,
  AllowedEnterTime
}

Resource {PCGen, Decoder, JumpDecoder}
Resource {IPort_R, DPort_R, DPort_W}
Resource {Decoder_V, Reg_V, ResCtrl, V_Retire}

/* Decode */
Resource {
  Vset,
  ID_Signaller
}

/****** Microactions ******/

/* uA Instruction Fetch */
Microaction {
  uA_IF_IFetch          (Pc -> IPort_R),
  uA_IF_PCGen           (Pc -> PCGen -> Pc_p),
  uA_IF_Req_VsetSignal  (VsetSignal)
}

/* uA Decode */
Microaction {
  uA_ID_Decode                (Decoder),
  uA_ID_JumpDecode            (JumpDecoder -> Pc_np),
  uA_ID_JumpDecodeReg         (Xa -> JumpDecoder -> Pc_np),
  uA_ID_Req_SReg_A            (Xa),
  uA_ID_Req_SReg_B            (Xb),
  uA_ID_Req_VsetSignal        (VsetSignal)
}

/************************************ Stages & Pipeline ************************************/

// Scalar Pipeline

/* Scalar EX */
Resource {
  EX_Nop,
  EX_ALU,
  EX_MUL,
  EX_MULH(4),
  EX_DIV(divider), 
  EX_DIVU(divider_u),
  EX_LSU,
  EX_CSR,
  EX_Signaller,
  EX_XIF (0)
}

Microaction {
  uA_EX_Vset                  (Vset -> Xd),
  uA_EX_VsetSignal            (EX_Signaller -> VsetSignal),
  uA_EX_Nop                   (EX_Nop),
  uA_EX_Req_MemArbiter_Signal (MemArbiterSignal),
  uA_EX_Req_SyncSignal        (SyncSignal),
  uA_EX_LSU                   (EX_LSU),
  uA_EX_ALU_RegUpdate         (EX_ALU -> Xd),
  uA_EX_ALU_Branch            (EX_ALU -> Pc_np),
  uA_EX_CSR                   (EX_CSR -> Xd),
  uA_MUL                      (EX_MUL -> Xd),
  uA_MULH                     (EX_MULH -> Xd),
  uA_DIV                      (EX_DIV -> Xd),
  uA_DIVU                     (EX_DIVU -> Xd),
  uA_EX_Req_WbFreeSignalSync  (WbFreeSignalSync),
  uA_EX_Req_WbFreeSignal      (WbFreeSignal),
  uA_EX_XifCommit             (EX_XIF -> XifCommitSignal)
}

Stage {
  EX_stg (
    uA_EX_ALU_RegUpdate, 
    uA_EX_ALU_Branch, 
    uA_EX_CSR,
    uA_EX_Req_MemArbiter_Signal,
    uA_EX_Req_SyncSignal,
    uA_EX_Req_WbFreeSignalSync,
    uA_EX_Req_WbFreeSignal,
    uA_EX_LSU, 
    uA_MUL, 
    uA_MULH, 
    uA_DIV, 
    uA_DIVU, 
    uA_EX_Nop,
    uA_EX_Vset,
    uA_EX_VsetSignal,
    uA_EX_XifCommit
  )
}

/* Scalar Writeback */
Resource {
  WB_Signaller,
  WB_Nop,
  EX_WB_XIF (0),
  WB_CSR
}

Microaction {
  uA_WB_Memory_R            (DPort_R -> Xd),
  uA_WB_Memory_W            (DPort_W),
  uA_WB_Nop                 (WB_Nop),
  uA_WB_VsetSignal          (WB_Signaller -> VsetSignal),
  uA_WB_XifCommit           (EX_WB_XIF -> XifCommitSignal),
  uA_WB_CSR                 (WB_CSR -> Xd)
}

Stage {
  WB_stg (
    uA_WB_Memory_R,
    uA_WB_Memory_W,
    uA_WB_Nop,
    uA_WB_VsetSignal,
    uA_WB_XifCommit,
    uA_WB_CSR
  )        
}

/* Vector EX substages */

/* LSU/ELM Pipeline */

Resource {
  // LSU Unit Pipeline
  Memory                  (1),
  V_EX_LSU_Mem            (vectorMemModel),
  V_EX_LSU_Mem_Nf         (vectorMemNfModel),
  V_EX_LSU_RegWriter      (0),
  V_EX_LSU_MemArbiter_Signaller,
  V_EX_LSU_REQ_Buffer,
  V_EX_LSU_RESP_Buffer,
  V_EX_LSU_Staller        (0),

  // ELM Unit Pipeline
  V_EX_ELM                (vectorElmModel),
  V_EX_ELM_RegWriter      (0)
}

Microaction {
  // LSU Unit Pipeline
  uA_V_EX_LSU_MemRequest                  (Memory),
  // uA_V_EX_LSU_MemArbiter_Signal           (V_EX_LSU_MemArbiter_Signaller -> MemArbiterSignal),
  uA_V_EX_LSU_Load_SetGroup               (V_EX_LSU_RegWriter -> VdGroupLoad),
  uA_V_EX_LSU_Load_Nf_SetGroup            (V_EX_LSU_RegWriter -> VdGroupLoadNf),
  uA_V_EX_LSU_Use                         (V_EX_LSU_Mem),
  uA_V_EX_LSU_Use_Nf                      (V_EX_LSU_Mem_Nf),
  uA_V_EX_LSU_Buffer_Request              (V_EX_LSU_REQ_Buffer -> FreeLastLsuElmUnpackStage),
  uA_V_EX_LSU_REQ_Buffer_Req_ReqStallEnd  (ReqStallEnd),
  uA_V_EX_LSU_Buffer_Response             (V_EX_LSU_RESP_Buffer),
  // V Loads stall V stores in unpack
  // uA_V_EX_LSU_End_Stalls_Load             (V_EX_LSU_Staller -> LoadStoreStallEnd),
  // uA_V_EX_LSU_End_Stalls_Store            (V_EX_LSU_Staller -> ReqStallEnd),

  // ELM Unit Pipeline
  uA_V_EX_ELM_Use                         (V_EX_ELM),
  uA_V_EX_ELM_SetGroup                    (V_EX_ELM_RegWriter -> VdGroupElm),
  uA_V_EX_ELM_SetGroupReduce              (V_EX_ELM_RegWriter -> VdGroupReduce)
}

Stage {
  // LSU Unit Pipeline
  V_EX_LSU_BUF_REQ_stg (
    uA_V_EX_LSU_Buffer_Request,
    uA_V_EX_LSU_REQ_Buffer_Req_ReqStallEnd
  ),
  V_EX_LSU_REQ_stg (
    uA_V_EX_LSU_MemRequest
    // uA_V_EX_LSU_MemArbiter_Signal
  ),
  V_EX_LSU_BUF_RESP_stg (
    uA_V_EX_LSU_Use,
    uA_V_EX_LSU_Use_Nf,
    uA_V_EX_LSU_Load_SetGroup,
    uA_V_EX_LSU_Load_Nf_SetGroup
    // uA_V_EX_LSU_Buffer_Response,
    // uA_V_EX_LSU_End_Stalls_Load,
    // uA_V_EX_LSU_End_Stalls_Store
  ),

  // ELM Unit Pipeline
  V_EX_ELM_stg (
    uA_V_EX_ELM_Use, 
    uA_V_EX_ELM_SetGroup,
    uA_V_EX_ELM_SetGroupReduce
  )
}

/* Subpipelines of V_EX_stg */

Pipeline {
  V_EX_LSU_subpipeline (
    V_EX_LSU_BUF_REQ_stg ->
    V_EX_LSU_REQ_stg ->
    V_EX_LSU_BUF_RESP_stg
  ),
  V_EX_ELM_subpipeline (V_EX_ELM_stg)
}

Resource {
  V_EX_Arith_Packer,
  V_EX_Arith_Unpack_ShiftRegister (0),
  V_EX_LSU_ELM_Packer,
  V_EX_LSU_ELM_Unpack_ShiftRegister (0)
}

// LSU/ELM Pipeline
Microaction {
  uA_V_EX_LSU_ELM_Enter_Unpack           (V_EX_LSU_ELM_Unpack_ShiftRegister -> EnterLsuElmUnpack),
  uA_V_EX_LSU_ELM_Enter_Unpack_Vs2       (V_EX_LSU_ELM_Unpack_ShiftRegister -> EnterLsuElmUnpackVs2),
  uA_V_EX_LSU_ELM_Enter_Unpack_Vs1_Vs2   (V_EX_LSU_ELM_Unpack_ShiftRegister -> EnterLsuElmUnpackVs1Vs2),
  uA_V_EX_LSU_ELM_Enter_Unpack_Load      (V_EX_LSU_ELM_Unpack_ShiftRegister -> EnterLsuElmUnpackLoad),
  uA_V_EX_LSU_ELM_Enter_Unpack_LoadNf    (V_EX_LSU_ELM_Unpack_ShiftRegister -> EnterLsuElmUnpackLoadNf),
  uA_V_EX_LSU_ELM_Enter_Unpack_Store     (V_EX_LSU_ELM_Unpack_ShiftRegister -> EnterLsuElmUnpackStore),
  uA_V_EX_LSU_ELM_Enter_Unpack_StoreNf   (V_EX_LSU_ELM_Unpack_ShiftRegister -> EnterLsuElmUnpackStoreNf),
  uA_V_EX_LSU_ELM_Leave_Unpack           (LeaveLsuElmUnpack),

  uA_V_EX_LSU_ELM_Pack                   (V_EX_LSU_ELM_Packer),
  uA_V_EX_LSU_ELM_Pack_CompleteLoad      (ReqStallEnd),

  // Arithmetic Pipeline
  uA_V_EX_Arith_Enter_Unpack             (V_EX_Arith_Unpack_ShiftRegister -> EnterArithUnpack),
  uA_V_EX_Arith_Enter_Unpack_Ext         (V_EX_Arith_Unpack_ShiftRegister -> EnterArithUnpackExt),
  uA_V_EX_Arith_Enter_Unpack_Vs2         (V_EX_Arith_Unpack_ShiftRegister -> EnterArithUnpackVs2),
  uA_V_EX_Arith_Enter_Unpack_Vs1_Vs2     (V_EX_Arith_Unpack_ShiftRegister -> EnterArithUnpackVs1Vs2),
  uA_V_EX_Arith_Leave_Unpack             (LeaveArithUnpack),
  uA_V_EX_Arith_Pack                     (V_EX_Arith_Packer)
}

Resource {
  V_EX_ALU              (vectorArithModel),
  V_EX_ALU_Widening     (vectorArithWideningModel),
  V_EX_MUL              (vectorArithModel),
  V_EX_MUL_Widening     (vectorArithWideningModel),
  V_EX_DIV              (vectorDivModel),
  V_EX_FPU              (vectorArithModel),
  V_EX_SLD              (vectorArithModel),
  V_EX_ALU_RegWriter    (0),
  V_EX_MUL_RegWriter    (0),
  V_EX_DIV_RegWriter    (0),
  V_EX_FPU_RegWriter    (0),
  V_EX_SLD_RegWriter    (0),

  // ALU Buffers
  V_EX_ALU_OP_Buffer,
  V_EX_ALU_INT_Buffer,

  // MUL Buffers
  V_EX_MUL_OP_Buffer,
  V_EX_MUL_IN_Buffer,
  V_EX_MUL_OUT_Buffer
}

Microaction {
  uA_V_EX_ALU_Use           (V_EX_ALU),
  uA_V_EX_ALU_Widening_Use  (V_EX_ALU_Widening),
  uA_V_EX_MUL_Use           (V_EX_MUL),
  uA_V_EX_MUL_Widening_Use  (V_EX_MUL_Widening),
  uA_V_EX_DIV_Use           (V_EX_DIV),
  uA_V_EX_FPU_Use           (V_EX_FPU),
  uA_V_EX_SLD_Use           (V_EX_SLD),

  uA_V_EX_ALU_SetGroup          (V_EX_ALU_RegWriter -> VdGroupArith),
  uA_V_EX_ALU_SetVd             (V_EX_ALU_RegWriter -> Vd),
  uA_V_EX_ALU_Widening_SetGroup (V_EX_ALU_RegWriter -> VdGroupArithWidening),
  uA_V_EX_MUL_SetGroup          (V_EX_MUL_RegWriter -> VdGroupArith),
  uA_V_EX_MUL_Widening_SetGroup (V_EX_MUL_RegWriter -> VdGroupArithWidening),
  uA_V_EX_DIV_SetGroup          (V_EX_DIV_RegWriter -> VdGroupDiv),
  uA_V_EX_FPU_SetGroup          (V_EX_FPU_RegWriter -> VdGroupArith),
  uA_V_EX_SLD_SetGroup          (V_EX_SLD_RegWriter -> VdGroupArith),

  // ALU Buffers
  uA_V_EX_ALU_Buffer_Ops            (V_EX_ALU_OP_Buffer),
  uA_V_EX_ALU_Buffer_Intermediate   (V_EX_ALU_INT_Buffer),
  uA_V_EX_ALU_Req_VregWritePortFree (VregWritePortFree),

  // MUL Buffers
  uA_V_EX_MUL_Buffer_Ops            (V_EX_MUL_OP_Buffer),
  uA_V_EX_MUL_Buffer_In             (V_EX_MUL_IN_Buffer),
  uA_V_EX_MUL_Buffer_Out            (V_EX_MUL_OUT_Buffer),
  uA_V_EX_MUL_Req_VregWritePortFree (VregWritePortFree)
}

Stage {
  // ALU Unit
  V_EX_ALU_BUF_OP_stg (uA_V_EX_ALU_Buffer_Ops),
  V_EX_ALU_BUF_INT_stg (uA_V_EX_ALU_Buffer_Intermediate, uA_V_EX_ALU_Req_VregWritePortFree),
  V_EX_ALU_stg (
    uA_V_EX_ALU_Use,
    uA_V_EX_ALU_Widening_Use,
    uA_V_EX_ALU_SetGroup,
    uA_V_EX_ALU_SetVd, 
    uA_V_EX_ALU_Widening_SetGroup
  ),

  // MUL Unit
  V_EX_MUL_BUF_OP_stg (uA_V_EX_MUL_Buffer_Ops),
  V_EX_MUL_BUF_IN_stg (uA_V_EX_MUL_Buffer_In),
  V_EX_MUL_BUF_OUT_stg (uA_V_EX_MUL_Buffer_Out, uA_V_EX_MUL_Req_VregWritePortFree),
  V_EX_MUL_stg (uA_V_EX_MUL_Use, uA_V_EX_MUL_Widening_Use, uA_V_EX_MUL_SetGroup, uA_V_EX_MUL_Widening_SetGroup),

  // DIV Unit
  V_EX_DIV_stg (
    uA_V_EX_DIV_Use, 
    uA_V_EX_DIV_SetGroup
  ),
  V_EX_FPU_stg (
    uA_V_EX_FPU_Use, 
    uA_V_EX_FPU_SetGroup
  ),
  V_EX_SLD_stg (
    uA_V_EX_SLD_Use, 
    uA_V_EX_SLD_SetGroup
  )
}

Pipeline {
  V_EX_ALU_subpipeline (V_EX_ALU_BUF_OP_stg -> V_EX_ALU_BUF_INT_stg -> V_EX_ALU_stg),
  V_EX_MUL_subpipeline (V_EX_MUL_BUF_OP_stg -> V_EX_MUL_BUF_IN_stg -> V_EX_MUL_BUF_OUT_stg -> V_EX_MUL_stg),
  V_EX_DIV_subpipeline (V_EX_DIV_stg),
  V_EX_FPU_subpipeline (V_EX_FPU_stg),
  V_EX_SLD_subpipeline (V_EX_SLD_stg)
}

Stage {
  // LSU/ELM Pipeline
  V_EX_LSU_ELM_Unpack_Enter_stg (
    uA_V_EX_LSU_ELM_Enter_Unpack,
    uA_V_EX_LSU_ELM_Enter_Unpack_Vs2,
    uA_V_EX_LSU_ELM_Enter_Unpack_Vs1_Vs2,
    uA_V_EX_LSU_ELM_Enter_Unpack_Load,
    uA_V_EX_LSU_ELM_Enter_Unpack_LoadNf,
    uA_V_EX_LSU_ELM_Enter_Unpack_Store,
    uA_V_EX_LSU_ELM_Enter_Unpack_StoreNf
  ),
  V_EX_LSU_ELM_Unpack_Leave_stg (
    uA_V_EX_LSU_ELM_Leave_Unpack
  ),
  V_EX_LSU_ELM_Pack_stg (uA_V_EX_LSU_ELM_Pack, uA_V_EX_LSU_ELM_Pack_CompleteLoad),
  V_EX_LSU_ELM_Unit_stg [capacity:2] (V_EX_LSU_subpipeline, V_EX_ELM_subpipeline),

  // Arithmetic Pipeline
  V_EX_Arith_Unpack_Enter_stg (
    uA_V_EX_Arith_Enter_Unpack,
    uA_V_EX_Arith_Enter_Unpack_Ext,
    uA_V_EX_Arith_Enter_Unpack_Vs2,
    uA_V_EX_Arith_Enter_Unpack_Vs1_Vs2
  ),
  V_EX_Arith_Unpack_Leave_stg (
    uA_V_EX_Arith_Leave_Unpack
  ),
  V_EX_Arith_Pack_stg (
    uA_V_EX_Arith_Pack
  ),
  V_EX_Arith_Unit_stg [capacity: 5] (
    V_EX_ALU_subpipeline,
    V_EX_MUL_subpipeline,
    V_EX_DIV_subpipeline,
    V_EX_FPU_subpipeline,
    V_EX_SLD_subpipeline
  )
}

Pipeline {
  V_EX_Arith_Unit_pipeline (
    V_EX_ALU_subpipeline | 
    V_EX_MUL_subpipeline | 
    V_EX_DIV_subpipeline | 
    V_EX_FPU_subpipeline | 
    V_EX_SLD_subpipeline
  )    
}

Pipeline {
  V_EX_Arith_subpipeline (
    V_EX_Arith_Unpack_Enter_stg ->
    V_EX_Arith_Unpack_Leave_stg ->
    V_EX_Arith_Unit_stg
  ),
  V_EX_LSU_ELM_subpipeline (
    V_EX_LSU_ELM_Unpack_Enter_stg ->
    V_EX_LSU_ELM_Unpack_Leave_stg ->
    V_EX_LSU_ELM_Unit_stg ->
    V_EX_LSU_ELM_Pack_stg ->
    V_RES_stg
  )
}

/* Vector Pipeline */

/* Vector RES */
Resource {
  V_RES_Nop,
  V_RES_Return_Result,
  V_RES_Signaller,
  V_RES_LSUSignaller
}

Microaction {
  uA_V_RES_Nop              (V_RES_Nop),
  uA_V_RES_Return_Result    (V_RES_Return_Result -> Xd),
  uA_V_RES_SyncSignal       (V_RES_Signaller -> SyncSignal),
  uA_V_RES_WbFreeSignalSync (V_RES_Signaller -> WbFreeSignalSync)
}

Stage {
  V_RES_stg (
    uA_V_RES_Nop,
    uA_V_RES_Return_Result,
    uA_V_RES_SyncSignal,
    uA_V_RES_WbFreeSignalSync
  )
}

/* Vector DISP */
Resource {Dispatcher}

Microaction {
  uA_V_DISP_Dispatch                          (Dispatcher),
  uA_V_DISP_Req_Vs1                           (Vs1),
  uA_V_DISP_Req_Vs2                           (Vs2),
  uA_V_DISP_Req_Vs3                           (Vs3),
  uA_V_DISP_Req_MaxVdGroup                    (MaxVdGroup),
  uA_V_DISP_Req_MaxVdGroupNf                  (MaxVdGroupNf),
  uA_V_DISP_Req_MaxVdGroupLoadStore           (MaxVdGroupLoadStore),
  uA_V_DISP_Req_Vd                            (Vd),
  uA_V_DISP_Req_MaskReg                       (MaskReg),
  uA_V_DISP_Req_AllowedEnterTime_LsuElmUnpack (AllowedEnterTimeLsuElmUnpack),
  uA_V_DISP_Req_AllowedEnterTime_ArithUnpack  (AllowedEnterTimeArithUnpack),
  uA_V_DISP_Req_WbFreeSignal                  (WbFreeSignal),
  uA_V_DISP_Req_CompleteLoad                  (CompleteLoad)
}

Stage {
  V_DISP_stg (
    uA_V_DISP_Dispatch, 
    uA_V_DISP_Req_Vs1,
    uA_V_DISP_Req_Vs2,
    uA_V_DISP_Req_Vs3,
    uA_V_DISP_Req_Vd,
    uA_V_DISP_Req_MaxVdGroup,
    uA_V_DISP_Req_MaxVdGroupNf,
    uA_V_DISP_Req_MaxVdGroupLoadStore,
    uA_V_DISP_Req_MaskReg,
    uA_V_DISP_Req_AllowedEnterTime_LsuElmUnpack,
    uA_V_DISP_Req_AllowedEnterTime_ArithUnpack,
    uA_V_DISP_Req_WbFreeSignal
  )
}

/* Vector Decode */

Resource {
  V_ID_Decoder
}

Microaction {
  uA_V_ID_Decode           (V_ID_Decoder),
  uA_V_ID_Req_SReg_A       (Xa),
  uA_V_ID_Req_SReg_B       (Xb),
  uA_V_ID_Req_VsetSignal   (VsetSignal),
  uA_V_ID_Req_WbFreeSignal (WbFreeSignal)
}

Stage {
  V_ID_stg (
    uA_V_ID_Decode,
    uA_V_ID_Req_VsetSignal,
    uA_V_ID_Req_WbFreeSignal
  )
}

/* Vector Instruction Queue */

Resource {
  V_IQ_Queue,
  V_IQ_Signaller
}

Microaction {
  uA_V_IQ_Queue (V_IQ_Queue)
}

Stage {
  V_IQ_stg [capacity: 2] (
    uA_V_IQ_Queue
  )
}

// Full Pipeline

// Shared Stages
Stage {
  IF_stg (
    uA_IF_IFetch,
    uA_IF_PCGen,
    uA_IF_Req_VsetSignal
  ),
  ID_stg (
    uA_ID_Decode, 
    uA_ID_JumpDecode,
    uA_ID_JumpDecodeReg,
    uA_ID_Req_SReg_A,
    uA_ID_Req_SReg_B,
    uA_ID_Req_VsetSignal
  )
}

Pipeline Scalar_pipeline (ID_stg -> EX_stg -> WB_stg)

Pipeline Vector_Parallel_Unit_pipeline (V_EX_Arith_subpipeline | V_EX_LSU_ELM_subpipeline)

Pipeline Vector_pipeline (V_ID_stg -> V_IQ_stg -> V_DISP_stg -> Vector_Parallel_Unit_pipeline)

Pipeline Parallel_pipeline (Scalar_pipeline | Vector_pipeline)

Pipeline Full_pipeline (IF_stg -> Parallel_pipeline)

/************************************* External Models *************************************/
TraceValue {
  rs1, 
  rs2, 
  rd, 
  pc, 
  brTarget, 
  rs2_data, 
  vtype, 
  vl, 
  vs1, 
  vs2, 
  vs3,
  vd, 
  vm,
  nf,
  lsWidth
}

ConnectorModel regModel (
  link : "models/common/StandardRegisterModel.h"
  trace : {rs1, rs2, rd}
  connectorIn : Xd
  connectorOut : {Xa, Xb}
)

ConnectorModel vectorRegModel (
  link : "models/Vicuna/VectorRegisterModel.h"
  trace : {vs1, vs2, vs3, vd, vm, vtype, lsWidth, nf}
  connectorIn : {
    Vd,
    VdGroupDiv,
    VdGroupArith,
    VdGroupArithWidening,
    VdGroupElm,
    VdGroupReduce,
    VdGroupLoad,
    VdGroupLoadNf
  }
  connectorOut : {
    Vs1,
    Vs2,
    Vs3,
    MaskReg,
    MaxVdGroup,
    MaxVdGroupNf,
    MaxVdGroupLoadStore,
    // LSU/ELM Unpack
    AllowedEnterTimeLsuElmUnpack,
    EnterLsuElmUnpack,
    EnterLsuElmUnpackVs2,
    EnterLsuElmUnpackVs1Vs2,
    EnterLsuElmUnpackLoad,
    EnterLsuElmUnpackLoadNf,
    EnterLsuElmUnpackStore,
    EnterLsuElmUnpackStoreNf,
    LeaveLsuElmUnpack,
    FreeLastLsuElmUnpackStage,
    ReqStallEnd,
    CompleteLoad,
    LoadStoreStallEnd,
    // Arith Unpack
    AllowedEnterTimeArithUnpack,
    EnterArithUnpack,
    EnterArithUnpackExt,
    EnterArithUnpackVs2,
    EnterArithUnpackVs1Vs2,
    LeaveArithUnpack,
    VregWritePortFree,
    XifCommitSignal
  }
)

