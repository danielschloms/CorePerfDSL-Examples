/*********************************** Microaction Section ***********************************/
Connector {Pc, Pc_np, Pc_p}

// Scalar Registers
Connector {Xa, Xb, Xd}

Resource {PCGen, Decoder, JumpDecoder}
Resource {IPort_R, DPort_R, DPort_W}

/* Decode */
Resource {
  Vset,
  ID_Signaller
}

/****** Microactions ******/

/* uA Instruction Fetch */
Microaction {
  uA_IF_IFetch          (Pc -> IPort_R),
  uA_IF_PCGen           (Pc -> PCGen -> Pc_p),
  uA_IF_Req_VsetSignal  (VsetSignal)
}

/* uA Decode */
Microaction {
  uA_ID_Decode                (Decoder),
  uA_ID_JumpDecode            (JumpDecoder -> Pc_np),
  uA_ID_JumpDecodeReg         (Xa -> JumpDecoder -> Pc_np),
  uA_ID_Req_SReg_A            (Xa),
  uA_ID_Req_SReg_B            (Xb),
  uA_ID_Req_VsetSignal        (VsetSignal)
}

/************************************ Stages & Pipeline ************************************/

/* Scalar Pipeline */

Stage {
  IF_stg (
    uA_IF_IFetch,
    uA_IF_PCGen,
    uA_IF_Req_VsetSignal
  ),
  ID_stg (
    uA_ID_Decode, 
    uA_ID_JumpDecode,
    uA_ID_JumpDecodeReg,
    uA_ID_Req_SReg_A,
    uA_ID_Req_SReg_B,
    uA_ID_Req_VsetSignal
  )
}

/* Scalar EX */
Resource {
  EX_Nop,
  EX_ALU,
  EX_MUL,
  EX_MULH(4),
  EX_DIV(divider), 
  EX_DIVU(divider_u),
  EX_LSU,
  EX_CSR,
  EX_Signaller
}

Microaction {
  uA_EX_Vset                  (Vset -> Xd),
  uA_EX_VsetSignal            (EX_Signaller -> VsetSignal),
  uA_EX_Nop                   (EX_Nop),
  uA_EX_LSU                   (EX_LSU),
  uA_EX_ALU_RegUpdate         (EX_ALU -> Xd),
  uA_EX_ALU_Branch            (EX_ALU -> Pc_np),
  uA_EX_CSR                   (EX_CSR -> Xd),
  uA_MUL                      (EX_MUL -> Xd),
  uA_MULH                     (EX_MULH -> Xd),
  uA_DIV                      (EX_DIV -> Xd),
  uA_DIVU                     (EX_DIVU -> Xd),
  uA_EX_Req_WbFreeSignal      (WbFreeSignal)
}

Stage {
  EX_stg (
    uA_EX_ALU_RegUpdate, 
    uA_EX_ALU_Branch, 
    uA_EX_CSR,
    uA_EX_Req_WbFreeSignal,
    uA_EX_LSU, 
    uA_MUL, 
    uA_MULH, 
    uA_DIV, 
    uA_DIVU, 
    uA_EX_Nop,
    uA_EX_Vset,
    uA_EX_VsetSignal
  )
}

/* Scalar Writeback */
Resource {WB_Signaller, WB_Nop, WB_CSR}

Microaction {
  uA_WB_Memory_R            (DPort_R -> Xd),
  uA_WB_Memory_W            (DPort_W),
  uA_WB_Nop                 (WB_Nop),
  uA_WB_VsetSignal          (WB_Signaller -> VsetSignal),
  uA_WB_CSR                 (WB_CSR -> Xd)
}

Stage {
  WB_stg (
    uA_WB_Memory_R,
    uA_WB_Memory_W,
    uA_WB_Nop,
    uA_WB_VsetSignal,
    uA_WB_CSR
  )        
}

#include "Vicuna2_Pipeline.corePerfDsl"

Pipeline Scalar_pipeline (ID_stg -> EX_stg -> WB_stg)
Pipeline Parallel_pipeline (Scalar_pipeline | Vector_pipeline)
Pipeline Full_pipeline (IF_stg -> Parallel_pipeline)

/************************************* External Models *************************************/
TraceValue {
  rs1, rs2, rd, pc, 
  brTarget, rs2_data, vtype, vl, 
  vs1, vs2, vs3, vd, 
  vm, nf, simm5, lsWidth
}

ConnectorModel regModel (
  link : "models/common/StandardRegisterModel.h"
  trace : {rs1, rs2, rd}
  connectorIn : Xd
  connectorOut : {Xa, Xb}
)

ConnectorModel vectorBatchHandModel (
  link : "models/Vicuna2/VectorBatchHandModel.h"
  trace : {vs1, vs2, vs3, vd, vtype, lsWidth, nf, simm5}
  connectorIn : {
    VsetSignal,
    WbFreeSignal,
    Vd
  }
  connectorOut : {
    // WAW - Dispatch
    MaxVdGroup,
    MaxVdGroupWide,
    MaxVdGroupNf,
    MaxVdGroupLoad,
    // Signals
    VsetSignal,
    WbFreeSignal,
    Vs1,
    Vs2,
    Vs3
  }
)

ConnectorModel staBranchPredModel (
  link : "models/common/StaticBranchPredictModel.h"
  trace : {pc, brTarget}
  connectorIn : {Pc_np, Pc_p}
  connectorOut : Pc
)

ResourceModel divider (
  link: "models/cv32e40p/DividerModel.h"
  trace: rs2_data
)

ResourceModel divider_u (
  link: "models/cv32e40p/DividerUnsignedModel.h"
  trace: rs2_data
)

ResourceModel vectorFixedDelayV1 (
  link: "models/Vicuna2/VectorFixedDelayV1.h"
)

ResourceModel vectorFixedDelayV2 (
  link: "models/Vicuna2/VectorFixedDelayV2.h"
)

ResourceModel vectorElmDelay(
  link: "models/Vicuna2/VectorElmDelay.h"
  trace: {vtype}
)

ResourceModel vectorDivDelay(
  link: "models/Vicuna2/VectorDivDelay.h"
  trace: {vtype}
)

/*********************************** Instruction Section ***********************************/
InstrGroup {
  Arith_Ra_Rb (add, sub, xor, or, and, slt, sltu, sll, srl, sra),
  Arith_Ra (addi, xori, ori, andi, slti, sltiu, slli, srli, srai),
  Arith_X (auipc, lui),
  Mul_Ra_Rb (mul),
  MulH_Ra_Rb (mulh, mulhu, mulhsu),
  Div_Ra_Rb (div, rem),
  DivU_Ra_Rb (divu, remu),
  Csr_Ra (csrrw, csrrs, csrrc),
  Csr_X (csrrwi, csrrsi, csrrci),
  Store (sb, sh, sw),
  Load (lw, lh, lhu, lb, lbu),
  Branch_Ra_Rb (beq, bne, blt, bge, bltu, bgeu),

  V_Load (vle32_v, vle16_v, vle8_v),
  V_Load_Registers (vl8r_v, vl16r_v, vl32r_v),
  V_Store (vse32_u, vse16_u, vse8_u),
  V_Store_Registers (vsr_v),
  V_LS_32 (vle32_v, vse32_u),
  V_LS_16 (vle16_v, vse16_u),
  V_LS_8 (vle8_v, vse8_u),

  // Zero/Sign Extension
  V_Ext (vzext_vf2, vsext_vf2, vzext_vf4, vsext_vf4, vzext_vf8, vsext_vf8),

  // ALU op, target vd, source imm
  V_vmv_v_i (vmv_v_i),

  V_vmv_regs (vmvr_v),

  // From X[rs1] to vd[0]
  V_vmv_s_x (vmv_s_x),

  // From X[rs1] to vd[0]
  V_vmv_x_s (vmv_x_s),

  V_DIV_vv (vdiv_vv, vdivu_vv, vremu_vv, vrem_vv),
  V_DIV_vx (vdiv_vx, vdivu_vx, vremu_vx, vrem_vx),

  V_ALU_vv (
    vadd_vv, vsub_vv, vadc_vvm, vmadc_vv,
    vsbc_vvm, vmsbc_vv, vand_vv, vor_vv,
    vxor_vv, vsll_vv, vsrl_vv, vsra_vv,
    vmseq_vv, vmsne_vv, vmsltu_vv, vmslt_vv,
    vmsleu_vv, vmsle_vv, vminu_vv, vmin_vv,
    vmaxu_vv, vmax_vv, vmerge_vvm, vsaddu_vv,
    vsadd_vv, vssubu_vv, vssub_vv, vaaddu_vv,
    vaadd_vv, vasubu_vv, vasub_vv, vsmul_vv,
    vssrl_vv, vssra_vv
  ),

  V_ALU_vx (
    vadd_vx, vsub_vx, vrsub_vx, vadc_vxm,
    vmadc_vx, vsbc_vxm, vmsbc_vx, vand_vx,
    vor_vx, vxor_vx, vsll_vx, vsrl_vx,
    vsra_vx, vmseq_vx, vmsne_vx, vmsltu_vx,
    vmslt_vx, vmsleu_vx, vmsle_vx, vmsgtu_vx,
    vmsgt_vx, vminu_vx, vmin_vx, vmaxu_vx,
    vmax_vx, vmerge_vxm, vsaddu_vx, vsadd_vx,
    vssubu_vx, vssub_vx, vaaddu_vx, vaadd_vx,
    vasubu_vx, vasub_vx, vsmul_vx, vssrl_vx,
    vssra_vx
  ),

  V_MUL_vv (
    vmul_vv, vmulh_vv, vmulhu_vv, vmulhsu_vv,
    vmacc_vv, vnmsac_vv, vmadd_vv, vnmsub_vv
  ),

  V_ALU_Widening_vv (
    vwaddu_vv, vwsubu_vv, vwadd_vv, vwsub_vv,
    vwaddu_w_vv, vwsubu_w_vv, vwadd_w_vv, vwsub_w_vv
  ),

  V_MUL_Widening_vv (
    vwmul_vv, vwmulu_vv, vwmulsu_vv, vwmaccu_vv,
    vwmacc_vv, vwmaccsu_vv
  ),

  V_MUL_vx (
    vmul_vx, vmulh_vx, vmulhu_vx, vmulhsu_vx,
    vmacc_vx, vnmsac_vx, vmadd_vx, vnmsub_vx
  ),

  V_ALU_Widening_vx (
    vwaddu_vx, vwsubu_vx, vwadd_vx, vwsub_vx,
    vwaddu_w_vx, vwsubu_w_vx, vwadd_w_vx, vwsub_w_vx
  ),

  V_MUL_Widening_vx (
    vwmul_vx, vwmulu_vx, vwmulsu_vx, vwmaccu_vx,
    vwmacc_vx, vwmaccsu_vx, vwmaccus_vx
  ),

  V_ALU_vi (
    vadd_vi, vrsub_vi, vadc_vim, vmadc_vi,   
    vand_vi, vor_vi, vxor_vi, vsll_vi,
    vsrl_vi, vsra_vi, vmseq_vi, vmsne_vi,
    vmsleu_vi, vmsle_vi, vmsgtu_vi, vmsgt_vi,
    vmerge_vim, vsaddu_vi, vsadd_vi, vssrl_vi,
    vssra_vi
  ),

  V_ELEM (vcompress_vm),
  V_REDSUM (vredsum_vs, vredand_vs, vredor_vs, vredxor_vs),
  V_REDMINMAX (vredmaxu_vs, vredmax_vs, vredminu_vs, vredmin_vs),
  V_XRESULT (vcpop_m, vfirst_m),
  V_INDEX (vid_v, viota_m),

  V_SLD (
    vslideup_vx, vslidedown_vx, vslide1up_vx, vslide1down_vx,
    vslideup_vi, vslidedown_vi
  ),

  V_vsetivli (vsetivli),
  V_vsetvli (vsetvli),
  V_vsetvl (vsetvl),

  Default ([?])
}

MicroactionMapping {
  [ALL] :        {uA_IF_IFetch, uA_IF_PCGen},
  Arith_Ra_Rb :  {uA_ID_Decode, uA_ID_Req_SReg_A, uA_ID_Req_SReg_B, uA_EX_ALU_RegUpdate, uA_EX_Req_WbFreeSignal, uA_WB_Nop},
  Arith_Ra :     {uA_ID_Decode, uA_ID_Req_SReg_A, uA_EX_ALU_RegUpdate, uA_EX_Req_WbFreeSignal, uA_WB_Nop},
  Arith_X :      {uA_ID_Decode, uA_EX_ALU_RegUpdate, uA_EX_Req_WbFreeSignal, uA_WB_Nop},
  Mul_Ra_Rb :    {uA_ID_Decode, uA_ID_Req_SReg_A, uA_ID_Req_SReg_B, uA_MUL, uA_EX_Req_WbFreeSignal, uA_WB_Nop},
  MulH_Ra_Rb :   {uA_ID_Decode, uA_ID_Req_SReg_A, uA_ID_Req_SReg_B, uA_MULH, uA_EX_Req_WbFreeSignal, uA_WB_Nop},
  Div_Ra_Rb :    {uA_ID_Decode, uA_ID_Req_SReg_A, uA_ID_Req_SReg_B, uA_DIV, uA_EX_Req_WbFreeSignal, uA_WB_Nop},
  DivU_Ra_Rb :   {uA_ID_Decode, uA_ID_Req_SReg_A, uA_ID_Req_SReg_B, uA_DIVU, uA_EX_Req_WbFreeSignal, uA_WB_Nop},
  Csr_Ra :       {uA_ID_Decode, uA_ID_Req_SReg_A, uA_EX_Nop, uA_EX_Req_WbFreeSignal, uA_WB_CSR},
  Csr_X :        {uA_ID_Decode, uA_EX_Nop, uA_EX_Req_WbFreeSignal, uA_WB_CSR},
  Store :        {uA_ID_Decode, uA_ID_Req_SReg_A, uA_ID_Req_SReg_B, uA_EX_LSU, uA_EX_Req_WbFreeSignal, uA_WB_Memory_W},
  Load :         {uA_ID_Decode, uA_ID_Req_SReg_A, uA_EX_LSU, uA_EX_Req_WbFreeSignal, uA_WB_Memory_R},
  Branch_Ra_Rb : {uA_ID_Decode, uA_ID_Req_SReg_A, uA_ID_Req_SReg_B, uA_EX_ALU_Branch, uA_EX_Req_WbFreeSignal, uA_WB_Nop},
  jal :          {uA_ID_JumpDecode, uA_EX_ALU_RegUpdate, uA_EX_Req_WbFreeSignal, uA_WB_Nop},
  jalr :         {uA_ID_JumpDecodeReg, uA_EX_ALU_RegUpdate, uA_EX_Req_WbFreeSignal, uA_WB_Nop},

#include "Vicuna2_uAMapping.corePerfDsl" 
}

#define CSR_VTYPE "$csr{0xc21}"

#define VV_TRACE_VALUES \
vs1 = "$bitfield{vs1}", \
vs2 = "$bitfield{vs2}", \
vd  = "$bitfield{vd}",  \
vtype = CSR_VTYPE

#define VX_TRACE_VALUES \
vs2 = "$bitfield{vs2}", \
rs1 = "$bitfield{rs1}", \
vd  = "$bitfield{vd}",  \
vtype = CSR_VTYPE

#define VI_TRACE_VALUES \
vs2 = "$bitfield{vs2}", \
vd  = "$bitfield{vd}",  \
vtype = CSR_VTYPE


TraceValueMapping {
  [ALL] : {
      pc = "$pc"
  },

  Arith_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}"
  },

  Arith_Ra : {
    rs1 = "$bitfield{rs1}",
    rd  = "$bitfield{rd}"
  },

  Arith_X : {
    rd  = "$bitfield{rd}"
  },

  Mul_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}"
  },

  MulH_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}"
  },

  Div_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}",
    rs2_data = "$reg{$bitfield{rs2}}"
  },

  DivU_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}",
    rs2_data = "$reg{$bitfield{rs2}}"
  },

  Csr_Ra : {
    rs1 = "$bitfield{rs1}",
    rd  = "$bitfield{rd}"
  },
  
  Csr_X : {
    rd  = "$bitfield{rd}"
  },

  Store : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}"
  },

  Load : {
    rs1 = "$bitfield{rs1}",
    rd  = "$bitfield{rd}"
  },

  Branch_Ra_Rb : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    brTarget = "$pc + (((int16_t)($bitfield{imm} << 3)) >> 3)"
  },

  jal : {
    rd = "$bitfield{rd}",
    brTarget = "$pc + (((int32_t)($bitfield{imm} << 11)) >> 11)"
  },

  jalr : {
    rs1 = "$bitfield{rs1}",
    rd  = "$bitfield{rd}",
    brTarget = "($reg{$bitfield{rs1}} + (((int16_t)($bitfield{imm} << 4)) >> 4)) & -2U"
  },

  V_LS_32 : {lsWidth = "32"},
  V_LS_16 : {lsWidth = "16"},
  V_LS_8  : {lsWidth = "8"},

  V_Load : {
    vd = "$bitfield{vd}",
    rs1 = "$bitfield{rs1}",
    // VTYPE CSR Address = 0xC21
    // VL CSR Address = 0xC20;
    vtype = "$csr{0xC21}",
    vl = "$csr{0xC20}"
  },

  V_Load_Registers : {
    vd = "$bitfield{vd}",
    rs1 = "$bitfield{rs1}",
    nf = "$bitfield{nf}"
  },

  V_Store : {
    vs3 = "$bitfield{vs3}",
    rs1 = "$bitfield{rs1}",
    // VTYPE CSR Address = 0xC21
    // VL CSR Address = 0xC20;
    vtype = "$csr{0xC21}",
    vl = "$csr{0xC20}"
  },

  V_Store_Registers : {
    vs3 = "$bitfield{vs3}",
    rs1 = "$bitfield{rs1}",
    nf = "$bitfield{nf}"
  },

  V_Ext : {
    vs2 = "$bitfield{vs2}",
    vd  = "$bitfield{vd}",
    // VTYPE CSR Address = 0xC21
    vtype = "$csr{0xC21}"
  },

  V_vmv_regs : {
    vs2 = "$bitfield{vs2}",
    vd  = "$bitfield{vd}",
    // VTYPE CSR Address = 0xC21
    simm5 = "$bitfield{simm5}",
    vtype = "$csr{0xC21}"
  },

  V_vmv_v_i : {
    vd = "$bitfield{vd}",
    // VTYPE CSR Address = 0xC21
    vtype = "$csr{0xC21}"
  },

  V_vmv_s_x : {
    rs1 = "$bitfield{rs1}",
    vd = "$bitfield{vd}",
    vtype = "$csr{0xC21}"
  },

  V_vmv_x_s : {
    rd = "$bitfield{rd}",
    vs2 = "$bitfield{vs2}",
    vtype = "$csr{0xC21}"
  },

  V_XRESULT : {
    rd = "$bitfield{rd}",
    vs2 = "$bitfield{vs2}",
    vtype = "$csr{0xC21}"
  },

  V_INDEX : {
    vs2 = "$bitfield{vs2}",
    vd  = "$bitfield{vd}",
    // VTYPE CSR Address = 0xC21
    vtype = "$csr{0xC21}"
  },


  V_ALU_vv          : {VV_TRACE_VALUES},
  V_ALU_vx          : {VX_TRACE_VALUES},
  V_ALU_vi          : {VI_TRACE_VALUES},
  V_MUL_vv          : {VV_TRACE_VALUES},
  V_MUL_vx          : {VX_TRACE_VALUES},
  V_ALU_Widening_vv : {VV_TRACE_VALUES},
  V_ALU_Widening_vx : {VX_TRACE_VALUES},
  V_MUL_Widening_vv : {VV_TRACE_VALUES},
  V_MUL_Widening_vx : {VX_TRACE_VALUES},
  V_DIV_vv          : {VV_TRACE_VALUES},
  V_DIV_vx          : {VX_TRACE_VALUES},
  V_REDSUM          : {VV_TRACE_VALUES},
  V_REDMINMAX       : {VV_TRACE_VALUES},
  V_SLD             : {VX_TRACE_VALUES},

  V_vsetvl : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}"
  },

  V_vsetvli : {
    rs1 = "$bitfield{rs1}",
    rd  = "$bitfield{rd}"
  },

  V_vsetivli : {
    rd  = "$bitfield{rd}"
  }
}

/**************************************** Variants *****************************************/

CorePerfModel Vicuna_zvl64b (
  core : "RV32IMACFDV_zvl64b"
  use Pipeline : Full_pipeline
  use ConnectorModel : {
    regModel, 
    vectorBatchHandModel, 
    staBranchPredModel,
    vectorFixedDelayV1,
    vectorFixedDelayV2,
    vectorElmDelay,
    vectorDivDelay
  }
)

