  },

  V_ALU_Widening_vx : {
    vs2 = "$bitfield{vs2}",
    rs1 = "$bitfield{rs1}",
    vd  = "$bitfield{vd}",
    // VTYPE CSR Address = 0xC21
    vtype = "$csr{0xC21}"
  },

  V_MUL_Widening_vx : {
    vs2 = "$bitfield{vs2}",
    rs1 = "$bitfield{rs1}",
    vd  = "$bitfield{vd}",
    // VTYPE CSR Address = 0xC21
    vtype = "$csr{0xC21}"
  },

  V_ALU_vi : {
    vs2 = "$bitfield{vs2}",
    vd  = "$bitfield{vd}",
    // VTYPE CSR Address = 0xC21
    vtype = "$csr{0xC21}"
  },

  V_RED_vv : {
    vs1 = "$bitfield{vs1}",
    vs2 = "$bitfield{vs2}",
    vd  = "$bitfield{vd}",
    // VTYPE CSR Address = 0xC21
    vtype = "$csr{0xC21}"
  },

  V_vsetvl : {
    rs1 = "$bitfield{rs1}",
    rs2 = "$bitfield{rs2}",
    rd  = "$bitfield{rd}"
  },

  V_vsetvli : {
    rs1 = "$bitfield{rs1}",
    rd  = "$bitfield{rd}"
  },

  V_vsetivli : {
    rd  = "$bitfield{rd}"
  }
}

